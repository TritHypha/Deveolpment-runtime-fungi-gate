@version 1

/// Bounded direct-package translation of validatePostgresCredentialRef from
/// packages-ts/galerina-db-postgres/src/index.ts.
///
/// Credential custody, secret resolution, provider/network access and
/// connection execution remain explicit host boundaries. This pure leaf only
/// validates the reference shape and rejects credential-bearing URI text; it
/// never resolves, stores or transmits a secret. The path-taking flow retains
/// the TypeScript path override and the wrapper supplies its default.

record PostgresCredentialRef {
  kind: String
  ref: String
}

record PostgresDiagnostic {
  code: String
  severity: String
  message: String
  path: String
}

pure flow hasInlineCredentialUri(value: String) -> Bool
contract { intent { "Detect a scheme URI containing non-empty user and password sections before an at-sign, matching the source credential-bearing URI guard." } }
{
  let length: Int = value.length()
  mut marker: Int = 0
  while marker + 3 <= length {
    let firstOpt: Option<Char> = value.charAt(marker)
    let secondOpt: Option<Char> = value.charAt(marker + 1)
    let thirdOpt: Option<Char> = value.charAt(marker + 2)
    mut markerFound: Bool = false
    match firstOpt {
      Some(first) => {
        match secondOpt {
          Some(second) => {
            match thirdOpt {
              Some(third) => {
                if first == Char.fromCode(58) and second == Char.fromCode(47) and third == Char.fromCode(47) {
                  markerFound = true
                }
              }
              None => {}
              _ => {}
            }
          }
          None => {}
          _ => {}
        }
      }
      None => {}
      _ => {}
    }

    if markerFound == true {
      mut userPos: Int = marker + 3
      mut userLength: Int = 0
      mut stopped: Bool = false
      while userPos < length and stopped == false {
        let userCharOpt: Option<Char> = value.charAt(userPos)
        match userCharOpt {
          Some(userChar) => {
            if userChar == Char.fromCode(47) or userChar == Char.fromCode(64) or userChar.isWhitespace() {
              stopped = true
            }
            if stopped == false {
              if userChar == Char.fromCode(58) and userLength > 0 {
                mut partPos: Int = userPos + 1
                mut partLength: Int = 0
                mut partStopped: Bool = false
                while partPos < length and partStopped == false {
                  let partCharOpt: Option<Char> = value.charAt(partPos)
                  match partCharOpt {
                    Some(partChar) => {
                      if partChar == Char.fromCode(64) or partChar.isWhitespace() {
                        partStopped = true
                      }
                      if partStopped == false {
                        partLength = partLength + 1
                        partPos = partPos + 1
                      }
                    }
                    None => { partStopped = true }
                    _ => { partStopped = true }
                  }
                }
                if partLength > 0 and partPos < length {
                  let atOpt: Option<Char> = value.charAt(partPos)
                  match atOpt {
                    Some(at) => {
                      if at == Char.fromCode(64) { return true }
                    }
                    None => {}
                    _ => {}
                  }
                }
              }
              userLength = userLength + 1
              userPos = userPos + 1
            }
          }
          None => { stopped = true }
          _ => { stopped = true }
        }
      }
    }
    marker = marker + 1
  }
  return false
}

pure flow validatePostgresCredentialRef(
  credential: PostgresCredentialRef,
  path_: String,
) -> Array<PostgresDiagnostic>
contract { intent { "Validate external credential kind and non-empty reference while rejecting inline user-password connection strings in source diagnostic order." } }
{
  mut diagnostics: Array<PostgresDiagnostic> = Array.empty()

  if credential.kind != "external_ref" {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_POSTGRES_CREDENTIAL_KIND_INVALID"
      severity: "error"
      message: "Credential kind " + Char.fromCode(34).toString() + credential.kind + Char.fromCode(34).toString() + " is not " + Char.fromCode(34).toString() + "external_ref" + Char.fromCode(34).toString() + "; inline credentials are unrepresentable."
      path: path_ + ".kind"
    })
  }

  if credential.ref.trim().length() == 0 {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_POSTGRES_CREDENTIAL_REF_REQUIRED"
      severity: "error"
      message: "Credential reference must be a non-empty external reference."
      path: path_ + ".ref"
    })
  }
  if credential.ref.trim().length() > 0 and hasInlineCredentialUri(credential.ref) {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_POSTGRES_INLINE_CREDENTIALS_FORBIDDEN"
      severity: "error"
      message: "Credential reference contains an inline user:password connection string; credentials never travel inline."
      path: path_ + ".ref"
    })
  }

  return diagnostics
}

pure flow validatePostgresCredentialRefDefault(credential: PostgresCredentialRef) -> Array<PostgresDiagnostic>
contract { intent { "Validate a PostgreSQL credential reference using the source default credential path." } }
{
  return validatePostgresCredentialRef(credential, "credential")
}

