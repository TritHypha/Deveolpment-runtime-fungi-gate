@version 1

/// Bounded translation of validateFirestoreCredentialRef from
/// packages-ts/galerina-db-firestore/src/index.ts:197-229.
///
/// The TypeScript credential type and provider boundary remain the
/// compatibility shadow. This leaf validates only an external reference; it
/// never resolves, transports, or exposes credential material.

record FirestoreCredentialRef {
  kind: String
  ref: String
}

record FirestoreDiagnostic {
  code: String
  severity: String
  message: String
  path: String
}

pure flow isRegexWhitespace(codePoint: Int) -> Bool
contract { intent { "Recognize JavaScript regular-expression whitespace code points." } }
{
  if codePoint == 9 or codePoint == 10 or codePoint == 11 or codePoint == 12 or codePoint == 13 { return true }
  if codePoint == 32 or codePoint == 160 or codePoint == 5760 { return true }
  if codePoint >= 8192 and codePoint <= 8202 { return true }
  if codePoint == 8232 or codePoint == 8233 or codePoint == 8239 or codePoint == 8287 or codePoint == 12288 or codePoint == 65279 { return true }
  return false
}

pure flow charCodeAt(value: String, index: Int) -> Int
contract { intent { "Read one string code point with a negative missing sentinel." } }
{
  let characterOpt: Option<Char> = value.charAt(index)
  match characterOpt {
    Some(character) => { return character.codePoint() }
    None => { return 0 - 1 }
    _ => { return 0 - 1 }
  }
}

/// Detect /:\/\/[^\/@\s]+:[^@\s]+@/ without regex or provider effects.
pure flow containsInlineCredential(value: String) -> Bool
contract { intent { "Detect a user:password credential embedded after a URI authority marker." } }
{
  mut start: Int = 0
  while start + 2 < value.length() {
    if charCodeAt(value, start) == 58 and charCodeAt(value, start + 1) == 47 and charCodeAt(value, start + 2) == 47 {
      mut userIndex: Int = start + 3
      mut userLength: Int = 0
      mut userValid: Bool = true
      while userIndex < value.length() and userValid and charCodeAt(value, userIndex) != 58 {
        let codePoint: Int = charCodeAt(value, userIndex)
        if codePoint == 47 or codePoint == 64 or isRegexWhitespace(codePoint) {
          userValid = false
        } else {
          userLength = userLength + 1
        }
        userIndex = userIndex + 1
      }

      if userValid and userLength > 0 and userIndex < value.length() and charCodeAt(value, userIndex) == 58 {
        mut passwordIndex: Int = userIndex + 1
        mut passwordLength: Int = 0
        mut passwordValid: Bool = true
        while passwordIndex < value.length() and passwordValid and charCodeAt(value, passwordIndex) != 64 {
          let codePoint: Int = charCodeAt(value, passwordIndex)
          if isRegexWhitespace(codePoint) {
            passwordValid = false
          } else {
            passwordLength = passwordLength + 1
          }
          passwordIndex = passwordIndex + 1
        }

        if passwordValid and passwordLength > 0 and passwordIndex < value.length() and charCodeAt(value, passwordIndex) == 64 {
          return true
        }
      }
    }
    start = start + 1
  }
  return false
}

pure flow validateFirestoreCredentialRef(credential: FirestoreCredentialRef, path_: String) -> Array<FirestoreDiagnostic>
contract { intent { "Require external credential references and reject inline connection-string secrets." } }
{
  mut diagnostics: Array<FirestoreDiagnostic> = Array.empty()

  if credential.kind != "external_ref" {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_FIRESTORE_CREDENTIAL_KIND_INVALID",
      severity: "error",
      message: "Credential kind " + Char.fromCode(34).toString() + credential.kind + Char.fromCode(34).toString() + " is not " + Char.fromCode(34).toString() + "external_ref" + Char.fromCode(34).toString() + "; inline credentials are unrepresentable.",
      path: path_ + ".kind"
    })
  }

  if credential.ref.trim().length() == 0 {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_FIRESTORE_CREDENTIAL_REF_REQUIRED",
      severity: "error",
      message: "Credential reference must be a non-empty external reference.",
      path: path_ + ".ref"
    })
  } else {
    if containsInlineCredential(credential.ref) {
      diagnostics = diagnostics.append({
        code: "Galerina_DB_FIRESTORE_INLINE_CREDENTIALS_FORBIDDEN",
        severity: "error",
        message: "Credential reference contains an inline user:password connection string; credentials never travel inline.",
        path: path_ + ".ref"
      })
    }
  }

  return diagnostics
}
