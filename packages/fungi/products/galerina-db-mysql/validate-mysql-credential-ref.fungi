@version 1

/// Bounded translation of validateMysqlCredentialRef from
/// packages-ts/galerina-db-mysql/src/index.ts.
///
/// Credential material is never resolved here. The host supplies an inert
/// external reference, while provider, secret custody, and network effects
/// remain outside this pure validation leaf.

record MysqlCredentialRef {
  kind: String
  ref: String
}

record MysqlDiagnostic {
  code: String
  severity: String
  message: String
  path: String
}

pure flow isCredentialWhitespace(character: Char) -> Bool
contract { intent { "Recognize the ECMAScript whitespace code points excluded by the credential reference pattern." } }
{
  let codePoint: Int = character.codePoint()
  if codePoint == 9 or codePoint == 10 or codePoint == 11 or codePoint == 12 or codePoint == 13 { return true }
  if codePoint == 32 or codePoint == 160 or codePoint == 5760 { return true }
  if codePoint >= 8192 and codePoint <= 8202 { return true }
  if codePoint == 8232 or codePoint == 8233 or codePoint == 8239 or codePoint == 8287 or codePoint == 65279 { return true }
  if codePoint == 12288 { return true }
  return false
}

pure flow hasInlineCredentialString(ref_: String) -> Bool
contract { intent { "Recognize a scheme user:password at marker with the same bounded shape as the source credential regex." } }
{
  mut markerIndex: Int = 0
  mut found: Bool = false
  while markerIndex + 2 < ref_.length() and found == false {
    if ref_.slice(markerIndex, markerIndex + 3) == "://" {
      mut usernameIndex: Int = markerIndex + 3
      while usernameIndex < ref_.length() and found == false {
        let usernameOpt: Option<Char> = ref_.charAt(usernameIndex)
        match usernameOpt {
          Some(usernameChar) => {
            let usernameText: String = usernameChar.toString()
            if isCredentialWhitespace(usernameChar) or usernameText == "/" or usernameText == "@" {
              usernameIndex = ref_.length()
            }
            if usernameIndex < ref_.length() and usernameIndex > markerIndex + 3 and usernameText == ":" {
              mut payloadIndex: Int = usernameIndex + 1
              mut payloadHasChar: Bool = false
              mut payloadClosed: Bool = false
              while payloadIndex < ref_.length() and found == false and payloadClosed == false {
                let payloadOpt: Option<Char> = ref_.charAt(payloadIndex)
                match payloadOpt {
                  Some(payloadChar) => {
                    let payloadText: String = payloadChar.toString()
                    if payloadText == "@" {
                      if payloadHasChar == true { found = true }
                      payloadClosed = true
                    }
                    if payloadText != "@" and isCredentialWhitespace(payloadChar) {
                      payloadClosed = true
                    }
                    if payloadText != "@" and isCredentialWhitespace(payloadChar) == false {
                      payloadHasChar = true
                    }
                  }
                  None => { payloadClosed = true }
                  _ => { payloadClosed = true }
                }
                payloadIndex = payloadIndex + 1
              }
            }
          }
          None => { usernameIndex = ref_.length() }
          _ => { usernameIndex = ref_.length() }
        }
        usernameIndex = usernameIndex + 1
      }
    }
    markerIndex = markerIndex + 1
  }
  return found
}

pure flow validateMysqlCredentialRefAtPath(
  credential_: MysqlCredentialRef,
  path_: String,
) -> Array<MysqlDiagnostic>
contract { intent { "Reject non-external kinds, empty references, and inline user:password connection strings in source diagnostic order." } }
{
  mut diagnostics: Array<MysqlDiagnostic> = Array.empty()

  if credential_.kind != "external_ref" {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_MYSQL_CREDENTIAL_KIND_INVALID"
      severity: "error"
      message: "Credential kind " + Char.fromCode(34).toString() + credential_.kind + Char.fromCode(34).toString() + " is not " + Char.fromCode(34).toString() + "external_ref" + Char.fromCode(34).toString() + "; inline credentials are unrepresentable."
      path: path_ + ".kind"
    })
  }

  if credential_.ref.trim().length() == 0 {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_MYSQL_CREDENTIAL_REF_REQUIRED"
      severity: "error"
      message: "Credential reference must be a non-empty external reference."
      path: path_ + ".ref"
    })
  }
  if credential_.ref.trim().length() != 0 and hasInlineCredentialString(credential_.ref) {
    diagnostics = diagnostics.append({
      code: "Galerina_DB_MYSQL_INLINE_CREDENTIALS_FORBIDDEN"
      severity: "error"
      message: "Credential reference contains an inline user:password connection string; credentials never travel inline."
      path: path_ + ".ref"
    })
  }

  return diagnostics
}

pure flow validateMysqlCredentialRef(credential_: MysqlCredentialRef) -> Array<MysqlDiagnostic>
contract { intent { "Validate a MySQL credential reference using the source default diagnostic path." } }
{
  return validateMysqlCredentialRefAtPath(credential_, "credential")
}
