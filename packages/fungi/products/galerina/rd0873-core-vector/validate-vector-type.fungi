@version 1

/// Wave 02 bounded translation of validateVectorType from src/index.ts.
///
/// Lane counts stay Float64 so the source Number contract is not narrowed to
/// Fungi Int/i32.  The safe-integer predicate uses the exact binary64 boundary
/// and a finite decimal rendering for the fractional check.  The TypeScript
/// function remains the compatibility oracle and supplies its default path.

record VectorDimension {
  lanes: Float64
}

record VectorType {
  elementType: String
  dimension: VectorDimension
}

record VectorDiagnostic {
  code: String
  severity: String
  message: String
  path: String
}

pure flow isPositiveSafeInteger(value: Float64) -> Bool
contract { intent { "Accept exactly positive finite integer values representable as JavaScript safe integers." } }
{
  // Classify raw ingress before ordering so ±Infinity follows the source's
  // ordinary validation-diagnostic route instead of trapping in WASM.
  if Float64.isFinite(value) == false { return false }
  if value <= 0.0 { return false }
  if value >= 9007199254740992.0 { return false }
  let rendered: String = value.toString()
  if rendered.contains(".") { return false }
  if rendered.contains("e") or rendered.contains("E") { return false }
  return true
}

pure flow validateVectorType(vector: VectorType, path_: String) -> Array<VectorDiagnostic>
contract { intent { "Validate a vector element label and positive safe lane count in source diagnostic order." } }
{
  mut diagnostics: Array<VectorDiagnostic> = Array.empty()

  if vector.elementType.trim().length() == 0 {
    diagnostics = diagnostics.append({
      code: "Galerina_VECTOR_ELEMENT_TYPE_REQUIRED",
      severity: "error",
      message: "Vector element type is required.",
      path: path_ + ".elementType"
    })
  }

  if isPositiveSafeInteger(vector.dimension.lanes) == false {
    diagnostics = diagnostics.append({
      code: "Galerina_VECTOR_LANES_INVALID",
      severity: "error",
      message: "Vector lane count must be a positive safe integer.",
      path: path_ + ".dimension.lanes"
    })
  }

  return diagnostics
}
