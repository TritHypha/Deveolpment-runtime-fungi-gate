      "format": "markdown"
    },
    {
      "file": "docs/runtime-guide.md",
      "format": "markdown"
    },
    {
      "file": "docs/memory-pressure-guide.md",
      "format": "markdown"
    },
    {
      "file": "docs/run-compile-mode-guide.md",
      "format": "markdown"
    },
    {
      "file": "docs/deployment-guide.md",
      "format": "markdown"
    },
    {
      "file": "docs/ai-summary.md",
      "format": "markdown"
    },
    {
      "file": "docs/docs-manifest.json",
      "format": "json"
    }
  ]
