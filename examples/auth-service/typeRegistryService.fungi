@version 1
// Phase 46 — Type Registry Service
//
// Resolves type names against the Galerina built-in type registry.
// Answers whether a type name is a primitive built-in and what category it belongs to.
//
// This is the runtime-in-Galerina type system introspection service.
// It answers: "is this type built-in?" and "what category does it fall into?"
//
// HTTP POST /types/resolve  →  governance  →  type lookup  →  response

// Returns true when the type name is one of the Galerina primitive built-ins.
// Built-ins: Int, Bool, String, Float, Bytes, Unit, Void.
;; Returns whether a type name is one of the Galerina primitive built-ins; safe as a pure whitelist check over fixed constants.
;; Pure — no runtime authority / no effects.
// @cause  [resolveType] -> called to whitelist-check the requested type name.
// @effect [Verdict only] -> returns Bool; no state mutated.
pure flow isBuiltinType(name: String) -> Bool
contract {
  intent { "Return true when the type name is a Galerina built-in primitive." }
}
{
  match name {
    "Int" => { return true }
    "Bool" => { return true }
    "String" => { return true }
    "Float" => { return true }
    "Bytes" => { return true }
    "Unit" => { return true }
    "Void" => { return true }
    _ => { return false }
  }
}

// Returns the category string for the given type name.
// Categories: "primitive", "collection", "effect", "governance", "unknown".
;; Returns the category for a type name (primitive/collection/effect/governance/unknown); safe as a pure classification with no side effects.
;; Pure — no runtime authority / no effects.
// @cause  [resolveType] -> called to classify the requested type name.
// @effect [Verdict only] -> returns the category String; no state mutated.
pure flow typeCategory(name: String) -> String
contract {
  intent { "Return the category for the given type name." }
}
{
  match name {
    "Int" => { return "primitive" }
    "Bool" => { return "primitive" }
    "String" => { return "primitive" }
    "Float" => { return "primitive" }
    "Bytes" => { return "primitive" }
    "Unit" => { return "primitive" }
    "Void" => { return "primitive" }
    "List" => { return "collection" }
    "Map" => { return "collection" }
    "Set" => { return "collection" }
    when name.contains("Effect") => { return "effect" }
    when name.contains("Governance") => { return "governance" }
    _ => { return "unknown" }
  }
}

;; Validate an untrusted type name against the governed registry's recognised vocabulary before it drives
;; the resolution: admit the built-in primitives and collections by exact name, and the Effect / Governance
;; type families by their marker — returning a CONSTANT (never the raw input), normalising anything else to
;; "" — a validating gate that clears the taint. Returning the family marker (not the raw name) keeps
;; typeCategory's family classification intact without laundering the input. Pure — no authority / no effects.
// @cause  [Called before the type name drives the resolution] -> validates the untrusted type name.
// @effect [Verdict only] -> returns the validated type name/marker (or "" if unrecognised); no state mutated.
pure flow validateTypeName(name: String) -> String
{
  match name {
    "Int" => { return "Int" }
    "Bool" => { return "Bool" }
    "String" => { return "String" }
    "Float" => { return "Float" }
    "Bytes" => { return "Bytes" }
    "Unit" => { return "Unit" }
    "Void" => { return "Void" }
    "List" => { return "List" }
    "Map" => { return "Map" }
    "Set" => { return "Set" }
    when name.contains("Effect") => { return "Effect" }
    when name.contains("Governance") => { return "Governance" }
    _ => { return "" }
  }
}

// The governed type resolution endpoint.
// Accepts { typeName } and returns the resolved type metadata.
;; Resolves a type name against the governed type registry and returns its metadata; permitted because the untrusted type name is trapped-on-empty and redacted before the audit write.
;; V_DPM capability required: network.inbound, audit.write
// @cause  [POST /types/resolve] -> HTTP route invokes this governed endpoint with a type name.
// @effect [Audit log] -> appends a "TypeResolve" event (fields redacted); returns the resolved type metadata.
secure flow resolveType(readonly request: Request) -> Response
contract {
  intent { "Resolve a type name against the governed type registry." }
  effects {
    network.inbound
    audit.write
  }
}
{
  unsafe let typeName: String = request.jsonBody.typeName

  trap typeName == "" : ERR_EMPTY_TYPE_NAME
  ;; validate the untrusted type name against the recognised registry vocabulary before it drives the
  ;; resolution — the validating gate clears the taint
  let validTypeName: String = validateTypeName(typeName)
  trap validTypeName == "" : ERR_INVALID_TYPE_NAME
  let isBuiltin: Bool = isBuiltinType(validTypeName)
  let category: String = typeCategory(validTypeName)

  let retTypeName: String = validTypeName
  let retIsBuiltin: Bool = isBuiltin
  let retCategory: String = category
  safe mut auditTypeName = redact(typeName)
  safe mut auditIsBuiltin = redact(isBuiltin)
  safe mut auditCategory = redact(category)

  AuditLog.write({
    event: "TypeResolve",
    typeName: auditTypeName,
    isBuiltin: auditIsBuiltin,
    category: auditCategory
  })

  return Response.ok({
    typeName: retTypeName,
    isBuiltin: retIsBuiltin,
    category: retCategory,
    resolved: true
  })
}

route POST "/types/resolve" {
  request Request
  response Response
  flow resolveType
}
