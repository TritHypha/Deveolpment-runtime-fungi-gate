  "advisoryReview": {
    "reviewer": "GPT-6 Astra",
    "result": "PASS_NON_AUTHORIZING for a bounded dossier; HOLD translation/admission expansion",
    "snapshot": {
      "head": "f1088e9a3f47be33f937e061caf3a186dec346df",
      "tree": "e58241fd08806b8497b5dd7538c8c7161177dfd0"
    },
    "findings": [
      "SecureString references expose metadata only, but raw-value custody is outside this package and must not be inferred from redacted flags or report fields.",
      "redactText applies caller-supplied regular expressions sequentially, enforces a length ceiling and offers fail-closed/skip/throw modes; preserve regex flags normalization, replacement-token refusal, ordering, counts, Unicode and error behavior.",
