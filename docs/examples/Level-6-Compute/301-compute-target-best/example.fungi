@version 1
/// example: 301-compute-target-best
/// level: 6
/// concept: compute target selection with ordered preference and fallback
/// expected_diagnostics: none
/// ai_rule: Use prefer [...] to express hardware preference; always declare fallback cpu as the final safety net.
/// test_status: stable

secure flow embedText(text: String) -> Tensor<Float32, [1, 768]>

contract {
  intent {
    "Create a local embedding using the best admitted accelerator."
  }

  effects {
    ai.inference
  }
}
  compute target best { prefer [npu, gpu, cpu] fallback cpu }
{
  return EmbeddingModel.embed(text)
}
