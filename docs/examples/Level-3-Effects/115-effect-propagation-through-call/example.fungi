@version 1
/// example: 115-effect-propagation-through-call
/// level: 3
/// concept: effect propagation through a flow call chain
/// expected_diagnostics: none
/// test_status: stable
/// ai_rule: A flow calling another flow must declare all effects required by the callee.

record Order {
  customerId: CustomerId
}

secure flow saveOrder(order: Order) -> SaveOrderResult

contract {
  types {
    type SaveOrderResult = Result<OrderId, OrderError>
  }

  intent {
    "Persist an order to the database and return the generated order ID."
  }

  effects {
    database.write
    audit.write
  }
}
{
  let safeOrder: Order = validate.order(order)?
  let orderId = OrdersDB.insert(safeOrder)?
  AuditLog.write({ action: "saveOrder", orderId: orderId })
  return Ok(orderId)
}

secure flow processOrder(order: Order) -> ProcessOrderResult

contract {
  types {
    type ProcessOrderResult = Result<OrderId, ProcessError>
  }

  intent {
    "Process an order by delegating to saveOrder — inherits its database.write effect."
  }

  effects {
    database.write
    audit.write
  }
}
{
  let orderId = saveOrder(order)?
  AuditLog.write({ action: "processOrder", orderId: orderId })
  return Ok(orderId)
}
