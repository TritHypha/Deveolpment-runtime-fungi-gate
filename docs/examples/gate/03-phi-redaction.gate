@gate 3.0.0
# Pattern: healthcare PHI. MIGRATED from v1.2 to v3. TWO protected fields are
# cut before egress. The security property is still visible in the shape:
# there is NO wire from the raw read to OUT.value; the only path to egress
# passes through the cut, which dominates it.
CIRCUIT get_patient(caller: CallerId, patient_ref: PatientRef) -> PatientView
  INTENT "Return a patient record to an authorised caller; PatientId and SSN are redacted before egress."
  REQUIRES:
    capability patient.read
    effect database.read
    effect audit.write
  PARTS:
    [authz :: galerina.tower.authorize@1.0.0 capability=patient.read]
    [raw :: app.patient.read@1.0.0]
    [view :: galerina.privacy.cut@1.0.0 fields={PatientId,SSN}]
    [logged :: galerina.audit.record@1.0.0 event="patient.read"]
  WIRES:
    IN.caller -> authz.subject
    IN.patient_ref -> authz.resource
    IN.patient_ref -> raw.key
    authz.allow -> raw.authority
    authz.deny -> DENY.not_authorized
    authz.indeterminate -> DENY.authority_unknown
    raw.value -> view.value
    raw.evidence -> view.evidence
    view.evidence -> logged.value
    view.value -> OUT.value
END
