@gate 3.0.0
# Pattern: authorised read with PII redaction. MIGRATED from the v1.2 glyph
# dialect to v3 named-port circuits (round-one G1).
#   ? guard      -> a K3 authority part with allow/deny/indeterminate ports
#   [check]/[cross]/[dash]  -> the arms are the wires themselves; refusals name a terminal
#   [name:fu op] -> [name :: component.id@version] (an exact registered part)
#   [:cut(F)]    -> [cut :: galerina.privacy.cut@1.0.0 fields={F}]
#   @effect tags -> derived from component contracts; REQUIRES states the envelope
#   [+]          -> OUT.value
CIRCUIT get_customer(caller: CallerId, customer_id: CustomerRef) -> CustomerView
  INTENT "Return one customer record to an authorised caller; PII is redacted before egress."
  REQUIRES:
    capability customer.read
    effect database.read
    effect audit.write
  PARTS:
    [authz :: galerina.tower.authorize@1.0.0 capability=customer.read]
    [record :: app.customer.read@1.0.0]
    [view :: galerina.privacy.cut@1.0.0 fields={CustomerId}]
    [logged :: galerina.audit.record@1.0.0 event="customer.read"]
  WIRES:
    IN.caller -> authz.subject
    IN.customer_id -> authz.resource
    IN.customer_id -> record.key
    authz.allow -> record.authority
    authz.deny -> DENY.not_authorized
    authz.indeterminate -> DENY.authority_unknown
    record.value -> view.value
    record.evidence -> view.evidence
    view.evidence -> logged.value
    view.value -> OUT.value
END
