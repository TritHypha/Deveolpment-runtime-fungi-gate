@gate 3.0.0
# Pattern: governed write (transaction). MIGRATED from v1.2 to v3.
# The deduction and the masking remain dense compute in registered components;
# the circuit is the shape. The masked amount is the only value that egresses.
CIRCUIT process_refund(client: CallerId, amount: Money) -> RefundReceipt
  INTENT "Issue a client refund and append it to the immutable audit log."
  REQUIRES:
    capability refund.issue
    effect database.write
    effect audit.write
  PARTS:
    [authz :: galerina.tower.authorize@1.0.0 capability=refund.issue]
    [posted :: app.ledger.deduct@1.0.0]
    [receipt :: galerina.privacy.cut@1.0.0 fields={Amount}]
    [logged :: galerina.audit.record@1.0.0 event="refund.issue"]
  WIRES:
    IN.client -> authz.subject
    IN.amount -> authz.resource
    IN.amount -> posted.amount
    authz.allow -> posted.authority
    authz.deny -> DENY.not_eligible
    authz.indeterminate -> DENY.eligibility_unknown
    posted.receipt -> receipt.value
    posted.evidence -> receipt.evidence
    posted.failure -> TRAP.ledger_write_failed
    receipt.evidence -> logged.value
    receipt.value -> OUT.value
END
