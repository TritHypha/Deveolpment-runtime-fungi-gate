@gate 3.0.0
# Pattern (advanced): tenant isolation + BOUNDED iteration + re-authorised egress.
# MIGRATED from v1.2 to v3, with one deliberate structural change:
#
#   the v1.2 drawing used a DRAWN CYCLE ([check-more] -> [page...] decreases budget).
#   v3 REFUSES every component cycle (GATE-TERM-003/004) - a budget on an edge
#   looks like a termination proof and is not one. The v3 idiom is an ITERATOR
#   PART whose bound is a contract argument: the paging loop lives inside
#   app.shard.scan_paged, which declares its own hop ceiling, so termination is
#   the component's proved obligation rather than a drawn back-edge.
#
# The four teaching points survive: cross-tenant reach TRAPs (fail-closed and
# distinct from a policy denial), iteration is bounded, a FRESH authority check
# re-authorises egress after the scan, and two explicit cuts scope then clean.
CIRCUIT search_records(caller: CallerId, query: Query, tenant_id: TenantId) -> RecordPage
  INTENT "Search records within the caller's tenant only, paging through a bounded number of hops."
  REQUIRES:
    capability records.search
    effect database.read
    budget hops=64
  PARTS:
    [authz :: galerina.tower.authorize.records@1.0.0 capability=records.search]
    [scope :: galerina.privacy.cut.scope@1.0.0 fields={TenantScope}]
    [tenant :: galerina.tower.authorize.tenant@1.0.0 capability=tenant.reach]
    [pages :: app.shard.scan_paged@1.0.0 max_hops=64]
    [egress :: galerina.tower.authorize.egress@1.0.0 capability=records.egress]
    [safe :: galerina.privacy.cut.records@1.0.0 fields={Records}]
  WIRES:
    IN.caller -> authz.subject
    IN.query -> authz.resource
    IN.tenant_id -> scope.value
    authz.allow -> scope.evidence
    authz.deny -> DENY.not_authorized
    authz.indeterminate -> DENY.authority_unknown
    scope.value -> tenant.subject
    scope.evidence -> tenant.resource
    tenant.allow -> pages.authority
    tenant.deny -> TRAP.cross_tenant_reach
    tenant.indeterminate -> DENY.tenant_reach_unknown
    pages.value -> egress.subject
    pages.evidence -> egress.resource
    pages.exhausted -> DENY.hop_budget_exhausted
    egress.allow -> safe.evidence
    egress.deny -> DENY.egress_refused
    egress.indeterminate -> DENY.egress_unknown
    pages.value -> safe.value
    safe.value -> OUT.value
END
