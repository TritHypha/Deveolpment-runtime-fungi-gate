@version 1
/// example: 013-match-option
/// level: 1
/// concept: match on Option
/// expected_diagnostics: none
/// test_status: stable
/// ai_rule: Every match on Option must handle both Some and None.

record User {
  name: String
}

pure flow example(user: Option<User>) -> String {
  match user {

    Some(value) =>
      return value.name

    None =>
      return "Missing"

    _ =>
      return "Unknown"
  }
}
