@version 1
/// example: 062-invalid-redacted-email
/// test_status: stable
/// level: 2
/// concept: protected Email cannot be assigned to redacted Email directly
/// expected_diagnostics: FUNGI-TYPE-034
/// ai_rule: Use redact(email) to explicitly redact a protected value before assigning to a redacted binding.

pure flow invalidRedactedEmail(email: protected Email) -> redacted Email {
  let auditEmail: redacted Email = email
  return auditEmail
}
