@version 1
// EXPECT: ACCEPT
// Pattern 8 — Emergency Policy Overlay (DRCM Phase 4 — task #39)
// Reference: ../ZTF-Knowledge-Bases/galerina-architecture-patterns.md
//
// policy { emergency { ... } } is DRCM Phase 4 — now live in Stage A.
// Demonstrates the structured emergency {} state machine parser (parseEmergencyBlock).
// FUNGI-MONO-001/002 verifier validates monotonicity of all transitions at compile time.
//
// The Monotonic Rule (M-003): emergency overlays are ONE-WAY.
// Once deny network.outbound fires — it cannot be reversed in this session.
// Overlays escalate (Tier 1 → Tier 2 → Tier 3) but never de-escalate.
// The operator must restart the DSS/Wasmtime session to restore capabilities.

record MonitoredPayload {
  order_id: String
  amount: Int
}

record ProcessingResult {
  status: String
  message: String
}

enum ProcessingError {
  PolicyViolation
  InvariantFailure
  MemoryPressure
  ServiceError
}

pure flow validateMonitoredPayload(readonly payload: MonitoredPayload) -> Result<MonitoredPayload, ProcessingError>
contract { effects {} }
{
  if payload.order_id == "" {
    return Err(ProcessingError.InvariantFailure)
  }
  if payload.amount <= 0 {
    return Err(ProcessingError.InvariantFailure)
  }
  return Ok(MonitoredPayload {
    order_id: payload.order_id
    amount: payload.amount
  })
}

secure flow monitoredPaymentProcessor(readonly payload: MonitoredPayload)
  -> Result<ProcessingResult, ProcessingError>
contract {
  intent { "Process payments with automatic security posture management on anomaly detection." }
  effects { database.write, network.outbound, audit.write, secret.read }
  secrets { bind "PAYMENT_KEY" }
  audit   { require cryptographic_state_hash }
  limits  { memory 64mb request_time 10s }
}
policy {
  emergency {
    on invariant_failure {
      deny network.outbound
      deny ai.inference
      quarantine
    }
    on capability_denied {
      deny network.outbound
      deny database.write
      quarantine
    }
    on any_failure {
      deny network.outbound
      emergency
    }
  }
}
{
  safe mut validatedPayload = validateMonitoredPayload(payload)?

  // Pre-flight check before cross-boundary call
  let receipt = security::interim::pre_flight_check(
    "monitoredPaymentProcessor",
    "payment_service::process",
    String.length(validatedPayload.order_id)
  )

  if !receipt.is_approved {
    return Err(ProcessingError.PolicyViolation)
  }

  let result = payment_service::process(validatedPayload.order_id, validatedPayload.amount)

  security::interim::post_flight_cleanup(receipt)

  AuditLog.write("PaymentProcessed: " + validatedPayload.order_id)

  return Ok(ProcessingResult { status: "ok", message: "payment processed" })
}
