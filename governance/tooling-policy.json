{
  "schemaVersion": 1,
  "packageNoTest": {
    "galerina-registry": {
      "reason": "Empty signed-package registry until the owner signing ceremony; no executable package surface exists.",
      "owner": "Galerina registry",
      "reviewWhen": "The first registry entry or executable source is added."
    }
  },
  "toolExceptions": {},
  "generators": {
    "scripts/code-index.mjs": {
      "inputs": [
        "packages-galerina",
        "docs",
        "scripts"
      ],
      "outputs": [
        "build/code-index/CODE_INDEX.md",
        "build/code-index/code-index.json",
        "build/code-index/provenance.json"
      ],
      "tracked": true,
      "generate": [
        "node",
        "scripts/code-index.mjs"
      ],
      "check": [
        "node",
        "scripts/code-index.mjs",
        "--check"
      ],
      "provenance": "required",
      "tier": "phase-close"
    },
    "scripts/dev-tool-index.mjs": {
      "inputs": [
        ".github/workflows",
        "galerina.workspace.json",
        "governance/tooling-policy.json",
        "packages-galerina",
        "proofs",
        "scripts",
        "version.json"
      ],
      "outputs": [
        "build/dev-tool-index/INDEX.md",
        "build/dev-tool-index/index.json",
        "build/dev-tool-index/packages.mmd",
        "build/dev-tool-index/provenance.json",
        "build/dev-tool-index/tooling.mmd"
      ],
      "tracked": true,
      "generate": [
        "node",
        "scripts/dev-tool-index.mjs"
      ],
      "check": [
        "node",
        "scripts/dev-tool-index.mjs",
        "--generator-check"
      ],
      "provenance": "required",
      "tier": "phase-close"
    },
    "scripts/gen-code-registry.mjs": {
      "inputs": [
        "AGENTS.md",
        "build/code-index/code-index.json",
        "docs",
        "examples",
        "galerina.mjs",
        "governance",
        "packages-galerina",
        "proofs",
        "scripts",
        "subprojects",
        "tests",
        "tools"
      ],
      "outputs": [
        "AGENTS.md",
        "build/code-registry/REGISTRY.md",
        "build/code-registry/provenance.json",
        "build/code-registry/registry.json"
      ],
      "tracked": true,
      "generate": [
        "node",
        "scripts/gen-code-registry.mjs"
      ],
      "check": [
        "node",
        "scripts/gen-code-registry.mjs",
        "--check"
      ],
      "provenance": "required",
      "tier": "phase-close"
    }
  }
}
