@version 1
// Benchmark request authority for the core-logic package.
//
// UInt32 shifts, XOR kernels, hardware counters, and wall-clock measurement are
// engine/host responsibilities. No Wasm/Rust/Python/SLIDE comparison is valid
// until SLIDE has an executable backend. This source therefore validates only
// the portable, deterministic request envelope.

type ComputeMixBenchmarkRequest {
  targetMs: Int
  requestedOperations: Int
  warmupMs: Int
  batchSize: Int
  bufferSize: Int
}

pure flow computeMixRequestAllowed(request: ComputeMixBenchmarkRequest) -> Bool {
  match request.targetMs {
    when request.targetMs < 10000 => return false
    when request.targetMs > 30000 => return false
    _ => {
      match request.requestedOperations {
        when request.requestedOperations < 0 => return false
        _ => {
          match request.warmupMs {
            when request.warmupMs < 0 => return false
            _ => {
              match request.batchSize {
                when request.batchSize <= 0 => return false
                _ => return request.bufferSize > 0
              }
            }
          }
        }
      }
    }
  }
}
