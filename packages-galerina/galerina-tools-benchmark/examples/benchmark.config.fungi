@version 1
// Benchmark execution remains host-owned until an executable SLIDE backend
// exists. This portable source validates the deterministic default request;
// it does not publish a cross-runtime performance claim.

type BenchmarkRequest {
  durationSeconds: Int
  submitResults: Bool
  includeHostIdentity: Bool
}

pure flow defaultBenchmarkRequest() -> BenchmarkRequest {
  return BenchmarkRequest {
    durationSeconds: 180
    submitResults: false
    includeHostIdentity: false
  }
}

pure flow benchmarkRequestAllowed(request: BenchmarkRequest) -> Bool {
  match request.submitResults {
    true => return false
    false => {
      match request.includeHostIdentity {
        true => return false
        false => return request.durationSeconds > 0
        _ => return false
      }
    }
    _ => return false
  }
}
