@version 1
pure flow responsePayload() -> Json {
  return json.decode<Json>("{\"items\":[{\"id\":1,\"test\":\"xxx\"},{\"id\":2,\"test\":\"xxx\"},{\"id\":3,\"test\":\"xxx\"}]}")
}

secure flow main() -> Result<Void, Error>
contract { intent { "Decode and print one deterministic JSON response payload." } }
{
  let payload: Json = responsePayload()
  console.log("json payload:\n" . json.pretty(payload))
  return Ok()
}
