@version 1
/// @file: registry-durability-admission.fungi
/// @purpose: Pure decision contract for a source-bound native registry-durability candidate.
///   CANDIDATE means evidence may proceed to review; it never means production admission.
/// @status: checker-verified contract; native platform adapters and production admission remain unbuilt.

/// Classify measured storage conservatively; every non-direct or unknown host exits denied.
pure flow hostStorageVerdict(
  volumeKind: String,
  network: Bool,
  removable: Bool,
  overlay: Bool,
  virtualStorage: Bool
) -> String
contract {
  intent { "Refuse every non-local, removable, overlay, virtual or unknown storage host fact." }
}
{
  if network == true {
    return "DENY"
  }
  if removable == true {
    return "DENY"
  }
  if overlay == true {
    return "DENY"
  }
  if virtualStorage == true {
    return "DENY"
  }
  match volumeKind {
    "fixed-local" => return "HOST_CANDIDATE"
    _ => return "DENY"
  }
}

/// Fold complete descriptor, evidence, host and identity facts into a non-authorizing candidate.
pure flow durabilityCandidateVerdict(
  descriptorValid: Bool,
  evidenceComplete: Bool,
  hostVerdict: String,
  identityMatches: Bool
) -> String
contract {
  intent { "Advance only a complete source-bound candidate; no result from this flow can admit production." }
}
{
  if descriptorValid == false {
    return "DENY"
  }
  if evidenceComplete == false {
    return "DENY"
  }
  match hostVerdict {
    "HOST_CANDIDATE" => {
      if identityMatches == true {
        return "CANDIDATE"
      }
      return "DENY"
    }
    _ => return "DENY"
  }
}

/// Admit only the exact release-linked proof shape while preserving non-authorizing status.
pure flow staticLinkProfileVerdict(
  evidenceComplete: Bool,
  schemaMatches: Bool,
  sourceMatches: Bool,
  contractMatches: Bool,
  abiMatches: Bool,
  releaseBuild: Bool,
  staticallyLinked: Bool,
  externalLoaderPresent: Bool,
  faultInjectionPresent: Bool
) -> String
contract {
  intent { "Keep static-link proof non-authorizing and refuse every incomplete, substituted, dynamic, debug or fault-enabled profile." }
}
{
  if evidenceComplete == false {
    return "INDETERMINATE"
  }
  if schemaMatches == false {
    return "DENY"
  }
  if sourceMatches == false {
    return "DENY"
  }
  if contractMatches == false {
    return "DENY"
  }
  if abiMatches == false {
    return "DENY"
  }
  if releaseBuild == false {
    return "DENY"
  }
  if staticallyLinked == false {
    return "DENY"
  }
  if externalLoaderPresent == true {
    return "DENY"
  }
  if faultInjectionPresent == true {
    return "DENY"
  }
  return "CANDIDATE_NON_AUTHORIZING"
}
