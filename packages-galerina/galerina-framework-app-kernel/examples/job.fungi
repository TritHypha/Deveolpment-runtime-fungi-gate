@version 1
// Queue names and resource limits are admitted host-manifest data. The .fungi
// decision surface remains portable across Windows, macOS, and Linux hosts.

type VideoJob {
  videoId: String
  attempt: Int
}

pure flow mayRetryVideoJob(job: VideoJob) -> Bool {
  match job.attempt {
    when job.attempt < 3 => return true
    _ => return false
  }
}
