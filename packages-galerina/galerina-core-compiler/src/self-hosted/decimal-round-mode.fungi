@version 1

/// Admit only an explicit canonical decimal rounding policy. Unknown,
/// malformed and non-canonical text remains outside the RoundMode domain.
pure flow isRoundModeFungi(mode: String) -> Bool
contract { intent { "Recognize exact decimal rounding modes without normalization or defaults." } }
{
  match mode {
    "halfEven" => { return true }
    "halfUp" => { return true }
    "halfDown" => { return true }
    "up" => { return true }
    "down" => { return true }
    "ceiling" => { return true }
    "floor" => { return true }
    _ => { return false }
  }
}
