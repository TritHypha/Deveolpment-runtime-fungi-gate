@version 1
/// @file: slide-gfrontend-checked-snapshot.fungi
/// @purpose: Seal one bounded immutable checked-module snapshot and total lowering trace.
/// @status: G4-C bounded snapshot floor; not a general frontend or authority source.

record SLIDEG4CheckedSnapshot {
  profileId: String
  sourceUnitId: Int
  logicalName: String
  normalizedPathIdentity: String
  sourceLanguageEdition: String
  sourceByteLength: Int
  sourceDigest: String
  diagnosticSetDigest: String
  errorCount: Int
  warningCount: Int
  checkerProfileId: String
  declarationDigest: String
  checkedFactsDigest: String
  recordDecls: Array<RecordDecl>
  enumDecls: Array<EnumDecl>
  flows: Array<FlowEntry>
  sourceMappings: Array<SLIDEV2ESourceMapEntry>
  instructionCount: Int
  terminatorCount: Int
  parserNodeCeiling: Int
  traceCeiling: Int
}

record SLIDEG4CheckedSnapshotResult {
  decision: SLIDEV2DExecutableDecision
  snapshot: SLIDEG4CheckedSnapshot
}

// Build the non-authorizing value returned by every snapshot refusal.
pure flow emptySLIDEG4CheckedSnapshot() -> SLIDEG4CheckedSnapshot
contract { intent { "Return a non-authorizing empty snapshot for terminal refusal." } }
{
  return {
    profileId: "" sourceUnitId: 0 logicalName: ""
    normalizedPathIdentity: "" sourceLanguageEdition: ""
    sourceByteLength: 0 sourceDigest: "" diagnosticSetDigest: ""
    errorCount: 0 warningCount: 0 checkerProfileId: ""
    declarationDigest: "" checkedFactsDigest: ""
    recordDecls: Array.empty() enumDecls: Array.empty()
    flows: Array.empty() sourceMappings: Array.empty()
    instructionCount: 0 terminatorCount: 0
    parserNodeCeiling: 0 traceCeiling: 0
  }
}

// Collapse a rejected snapshot request to one terminal decision and no facts.
pure flow refuseSLIDEG4CheckedSnapshot(
  failureId: String,
  detail: String,
) -> SLIDEG4CheckedSnapshotResult
contract { intent { "Refuse snapshot sealing without releasing partial checked facts." } }
{
  return {
    decision: refuseSLIDEV2DExecutable(failureId, detail)
    snapshot: emptySLIDEG4CheckedSnapshot()
  }
}

// Compare the input against the frozen normalized G4 source identity.
pure flow slideG4SnapshotSourceExact(sourceText: String) -> Bool
contract { intent { "Pin the bounded raw source bytes before any checked fact is sealed." } }
{
  let bytes = sourceText.encode()
  if bytes.length() != 1641 or sourceText.contains("\u000D") or sourceText.contains("\u0000") {
    return false
  }
  return bytes.sha256Hex() == "efa29344d4b837aaeabeef1419132586afb94f13fa747703b69d9b58568533a3"
}

// Prove lexer ranges are monotonic, bounded, and terminated at source end.
pure flow slideG4SnapshotTokensBounded(tokens: Array<Token>) -> Bool
contract { intent { "Require monotonic lexer byte ranges covering the exact bounded source." } }
{
  if tokens.count() == 0 or tokens.count() > 512 {
    return false
  }
  mut previousEnd: Int = 0
  mut sawSourceEnd: Bool = false
  mut index: Int = 0
  while index < tokens.count() {
    match tokens.get(index) {
      Some(token) => {
        if token.start < previousEnd or token.end < token.start or token.end > 1641 {
          return false
        }
        previousEnd = token.end
        if token.start == 1641 and token.end == 1641 {
          sawSourceEnd = true
        }
      }
      None => { return false }
      _ => { return false }
    }
    index = index + 1
  }
  return sawSourceEnd
}

// Compare every observable lexer fact without accepting partial agreement.
pure flow slideG4SnapshotTokensEqual(
  left: Array<Token>,
  right: Array<Token>,
) -> Bool
contract { intent { "Compare every lexer fact so caller-supplied tokens cannot disagree with source bytes." } }
{
  if left.count() != right.count() {
    return false
  }
  mut index: Int = 0
  while index < left.count() {
    match left.get(index) {
      Some(leftToken) => {
        match right.get(index) {
          Some(rightToken) => {
            let identity: Bool = leftToken.kind == rightToken.kind and leftToken.value == rightToken.value
            let start: Bool = leftToken.line == rightToken.line and leftToken.column == rightToken.column and leftToken.start == rightToken.start
            let finish: Bool = leftToken.endLine == rightToken.endLine and leftToken.endColumn == rightToken.endColumn and leftToken.end == rightToken.end
            if identity == false or start == false or finish == false {
              return false
            }
          }
          None => { return false }
          _ => { return false }
        }
      }
      None => { return false }
      _ => { return false }
    }
    index = index + 1
  }
  return true
}

// Re-tokenize the source and reject any caller-owned lexer substitution.
guarded flow slideG4SnapshotTokensMatchSource(
  tokens: Array<Token>,
  sourceText: String,
) -> Bool
contract { intent { "Re-lex the bound bytes and require exact token identity before sealing." } }
{
  let tokenized = tokenize(sourceText)
  match tokenized {
    Ok(expected) => { return slideG4SnapshotTokensEqual(tokens, expected) }
    Err(error) => { return false }
    _ => { return false }
  }
}

// Construct one immutable source-to-lowered-node trace entry.
pure flow slideG4TraceEntry(
  mapId: Int,
  functionId: Int,
  blockId: Int,
  nodeKindId: Int,
  nodeId: Int,
  startByte: Int,
  endByte: Int,
) -> SLIDEV2ESourceMapEntry
contract { intent { "Construct one exact bounded instruction or terminator source mapping." } }
{
  return {
    mapId: mapId functionId: functionId blockId: blockId
    nodeKindId: nodeKindId nodeId: nodeId sourceUnitId: 1
    startByte: startByte endByte: endByte
  }
}

// Enumerate the complete frozen instruction and terminator trace.
pure flow materializeSLIDEG4CheckedTrace() -> Array<SLIDEV2ESourceMapEntry>
contract { intent { "Materialize the complete instruction-level trace for the exact G4 fixture." } }
{
  mut trace: Array<SLIDEV2ESourceMapEntry> = Array.empty()

  trace = trace.append(slideG4TraceEntry(1, 1, 0, 1, 0, 179, 189))
  trace = trace.append(slideG4TraceEntry(2, 1, 0, 1, 1, 305, 306))
  trace = trace.append(slideG4TraceEntry(3, 1, 0, 1, 2, 297, 306))
  trace = trace.append(slideG4TraceEntry(4, 1, 0, 2, 4, 290, 306))

  trace = trace.append(slideG4TraceEntry(5, 2, 0, 1, 0, 340, 349))
