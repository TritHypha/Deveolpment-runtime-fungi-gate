@version 1
/// @file: slide-v2d-semantic-digest.fungi
/// @purpose: Bind independently decoded and validated V2-D bytes to the v2 semantic domain.
/// @status: Digest evidence only; never admission or execution authority.

record SLIDEV2DSemanticBinding {
  decision: SLIDEV2DExecutableDecision
  digestSuiteId: String
  domainId: String
  bodyDigest: String
  semanticDigest: String
  authorityReleased: Bool
}

pure flow emptySLIDEV2DSemanticBinding(
  decision: SLIDEV2DExecutableDecision,
) -> SLIDEV2DSemanticBinding
contract { intent { "Release no digest or authority for refused V2-D semantics." } }
{
  return {
    decision: decision digestSuiteId: "slide.digest.sha256.v1"
    domainId: "slide.gir.semantic.v2" bodyDigest: ""
    semanticDigest: "" authorityReleased: false
  }
}

pure flow bindSLIDEV2DSemanticDigest(
  body: Bytes,
) -> SLIDEV2DSemanticBinding
contract { intent { "Hash only exact independently decoded and admitted V2-D bytes." } }
{
  let imported = decodeSLIDEV2DProgram(body)
  check(imported.decision.verdict) {
    deny: { return emptySLIDEV2DSemanticBinding(imported.decision) }
    ambig: { return emptySLIDEV2DSemanticBinding(imported.decision) }
    if: {}
  }
  let domainPrefix = Bytes.fromHex(
    "736c6964652e6769722e73656d616e7469632e763200",
  )
  let bodyDigest = body.sha256Hex()
  let semanticDigest = domainPrefix.append(body).sha256Hex()
  if bodyDigest.length() != 64 or semanticDigest.length() != 64 {
    return emptySLIDEV2DSemanticBinding(
      refuseSLIDEV2DExecutable(
        "SLIDE-V2D-DIGEST-001", "registered SHA-256 primitive unavailable",
      ),
    )
  }
  return {
    decision: imported.decision digestSuiteId: "slide.digest.sha256.v1"
    domainId: "slide.gir.semantic.v2" bodyDigest: bodyDigest
    semanticDigest: semanticDigest authorityReleased: false
  }
}
