@version 1

/// Return the source-authoritative authority rank for one exact qualifier.
/// Every other admitted String has the closed fallback rank 0.
pure flow qualifierRank(qualifier: String) -> Int {
  if qualifier == "privileged" { return 4 }
  if qualifier == "secure" { return 3 }
  if qualifier == "guarded" { return 2 }
  if qualifier == "flow" { return 1 }
  return 0
}

/// Authority widens only when the after qualifier has a strictly higher rank.
/// This reference-only flow cannot switch the executing governance-diff path.
pure flow qualifierEscalated(before: String, after: String) -> Bool {
  if qualifierRank(after) > qualifierRank(before) { return true }
  return false
}
