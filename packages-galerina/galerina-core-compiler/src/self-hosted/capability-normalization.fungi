@version 1

/// Normalize the five closed admission aliases without prototype lookup.
/// Every non-alias String is returned byte-for-byte unchanged.
pure flow normalizeCapability(name: String) -> String
contract { intent { "Normalize only an explicitly governed capability alias." } }
{
  match name {
    "db.read" => { return "database.read" }
    "db.write" => { return "database.write" }
    "filesystem.read" => { return "storage.read" }
    "filesystem.write" => { return "storage.write" }
    "time.read" => { return "clock.read" }
    _ => { return name }
  }
}
