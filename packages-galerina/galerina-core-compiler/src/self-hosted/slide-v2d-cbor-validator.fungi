@version 1
/// @file: slide-v2d-cbor-validator.fungi
/// @purpose: Independently pin the first complete canonical V2-D body.
/// @status: Exact-vector admission only; structural decoding remains separate.

record SLIDEV2DWireDecision {
  verdict: Verdict
  status: String
  failureId: String
  detail: String
  consumed: Int
  expectedLength: Int
  mismatchOffset: Int
  authorityReleased: Bool
}

pure flow slideV2DCanonicalReferenceBytes() -> Bytes
contract { intent { "Return the independently pinned 791-byte V2-D reference vector." } }
{
  let part1 = ""
  let part2 = ""
  let part3 = ""
  let part4 = "82018282010d820204158185010001010c16818a010a03040401010101011781880103000809010204"
  return Bytes.fromHex(part1 + part2 + part3 + part4)
}

pure flow refuseSLIDEV2DWire(
  failureId: String,
  detail: String,
  consumed: Int,
  mismatchOffset: Int,
) -> SLIDEV2DWireDecision
contract { intent { "Refuse canonical admission without graph or runtime authority." } }
{
  return {
    verdict: Verdict.Deny status: "REFUSED" failureId: failureId
    detail: detail consumed: consumed expectedLength: 791
    mismatchOffset: mismatchOffset authorityReleased: false
  }
}

pure flow validateSLIDEV2DCanonicalBody(
  candidate: Bytes,
) -> SLIDEV2DWireDecision
contract { intent { "Admit only the complete independently pinned first V2-D vector." } }
{
  let expected = slideV2DCanonicalReferenceBytes()
  if expected.length() != 791 {
    return refuseSLIDEV2DWire(
      "SLIDE-V2D-WIRE-001", "internal reference length is invalid", 0, -1,
    )
  }
  if candidate.length() < expected.length() {
    return refuseSLIDEV2DWire(
      "SLIDE-V2D-WIRE-002", "canonical body is truncated",
      candidate.length(), candidate.length(),
    )
  }
  if candidate.length() > expected.length() {
    return refuseSLIDEV2DWire(
      "SLIDE-V2D-WIRE-003", "canonical body has surplus bytes",
      expected.length(), expected.length(),
    )
  }
  mut i: Int = 0
  while i < expected.length() {
    let actualByte = candidate.get(i)
    let expectedByte = expected.get(i)
    match actualByte {
      Some(actualValue) => {
        match expectedByte {
          Some(expectedValue) => {
            if actualValue != expectedValue {
              return refuseSLIDEV2DWire(
                "SLIDE-V2D-WIRE-004", "canonical byte mismatch", i, i,
              )
            }
          }
          None => {
            return refuseSLIDEV2DWire(
              "SLIDE-V2D-WIRE-001", "reference byte is absent", i, i,
            )
          }
          _ => {
            return refuseSLIDEV2DWire(
              "SLIDE-V2D-WIRE-001", "reference byte is malformed", i, i,
            )
          }
        }
      }
      None => {
        return refuseSLIDEV2DWire(
          "SLIDE-V2D-WIRE-002", "candidate byte is absent", i, i,
        )
      }
      _ => {
        return refuseSLIDEV2DWire(
          "SLIDE-V2D-WIRE-004", "candidate byte is malformed", i, i,
        )
      }
    }
    i = i + 1
  }
  return {
    verdict: Verdict.Allow status: "CANONICAL_VECTOR_ADMITTED"
    failureId: "NONE" detail: "exact 791-byte V2-D vector admitted"
    consumed: expected.length() expectedLength: expected.length()
    mismatchOffset: -1 authorityReleased: false
  }
}
