@version 1
/// @file: slide-v2c-cbor-validator.fungi
/// @purpose: Independently pin the first complete canonical V2-C body.
/// @status: Exact-vector admission only; structural decoding and graph reconstruction remain separate.

record SLIDEV2CWireDecision {
  verdict: Verdict
  status: String
  failureId: String
  detail: String
  consumed: Int
  expectedLength: Int
  mismatchOffset: Int
  authorityReleased: Bool
}

pure flow slideV2CCanonicalReferenceBytes() -> Bytes
contract { intent { "Return the independently pinned 725-byte V2-C reference vector." } }
{
  let part1 = ""
  let part2 = "8509110b8307080001850a120d810901850b130c810a01850c140d810b018304810c80010c8484010201018402030201840304020184040101010d800e800f8186010203040506108011801282840106014847616c6572696e618402070244000102ff138182018382010d820202820306148182018282010d820204"
  return Bytes.fromHex(part1 + part2)
}

pure flow refuseSLIDEV2CWire(
  failureId: String,
  detail: String,
  consumed: Int,
  mismatchOffset: Int,
) -> SLIDEV2CWireDecision
contract { intent { "Refuse canonical admission without semantic or runtime authority." } }
{
  return {
    verdict: Verdict.Deny status: "REFUSED" failureId: failureId
    detail: detail consumed: consumed expectedLength: 725
    mismatchOffset: mismatchOffset authorityReleased: false
  }
}

pure flow validateSLIDEV2CCanonicalBody(
  candidate: Bytes,
) -> SLIDEV2CWireDecision
contract { intent { "Admit only the complete independently pinned first V2-C canonical vector." } }
{
  let expected = slideV2CCanonicalReferenceBytes()
  if expected.length() != 725 {
    return refuseSLIDEV2CWire(
      "SLIDE-V2C-WIRE-001", "internal reference length is invalid", 0, -1,
    )
  }
  if candidate.length() < expected.length() {
    return refuseSLIDEV2CWire(
      "SLIDE-V2C-WIRE-002", "canonical body is truncated",
      candidate.length(), candidate.length(),
    )
  }
  if candidate.length() > expected.length() {
    return refuseSLIDEV2CWire(
      "SLIDE-V2C-WIRE-003", "canonical body has surplus bytes",
      expected.length(), expected.length(),
    )
  }
  mut i: Int = 0
  while i < expected.length() {
    let actualByte = candidate.get(i)
    let expectedByte = expected.get(i)
    match actualByte {
      Some(actualValue) => {
        match expectedByte {
          Some(expectedValue) => {
            if actualValue != expectedValue {
              return refuseSLIDEV2CWire(
                "SLIDE-V2C-WIRE-004", "canonical byte mismatch", i, i,
              )
            }
          }
          None => {
            return refuseSLIDEV2CWire(
              "SLIDE-V2C-WIRE-001", "reference byte is absent", i, i,
            )
          }
          _ => {
            return refuseSLIDEV2CWire(
              "SLIDE-V2C-WIRE-001", "reference byte is malformed", i, i,
            )
          }
        }
      }
      None => {
        return refuseSLIDEV2CWire(
          "SLIDE-V2C-WIRE-002", "candidate byte is absent", i, i,
        )
      }
      _ => {
        return refuseSLIDEV2CWire(
          "SLIDE-V2C-WIRE-004", "candidate byte is malformed", i, i,
        )
      }
    }
    i = i + 1
  }
  return {
    verdict: Verdict.Allow status: "CANONICAL_VECTOR_ADMITTED"
    failureId: "NONE" detail: "exact 725-byte V2-C vector admitted"
    consumed: expected.length() expectedLength: expected.length()
    mismatchOffset: -1 authorityReleased: false
  }
}
