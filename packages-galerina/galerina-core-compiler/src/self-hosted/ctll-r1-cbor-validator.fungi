@version 1
/// @file: ctll-r1-cbor-validator.fungi
/// @purpose: Independently validate the frozen CTLL R1 canonical semantic-body vector.
/// @status: Closed-profile reference validator; not a general-purpose CBOR decoder.
///
/// This file does not import or call the encoder. The accepted bytes are pinned
/// independently as a reviewable canonical vector. For a one-program frozen
/// profile, exact vector admission rejects non-shortest integers, indefinite
/// containers, reordered/duplicate keys, invalid UTF-8, hidden fields, changed
/// graph semantics, truncation, and trailing bytes with one bounded comparison.

record CTLLR1WireDecision {
  verdict: Verdict
  status: String
  failureId: String
  reason: String
  mismatchOffset: Int
  consumed: Int
  expectedLength: Int
  bodySha256: String
}

pure flow ctllR1CanonicalReferenceBytes() -> Bytes
contract { intent { "Return the independently pinned canonical R1 semantic-body vector." } }
{
  let part1: String = "ae0001010002781d63746c6c2e73656d616e7469632e67616c6572696e612d6769722e7631037563746c6c2e6469676573742e7368613235362e763104781963746c6c2e6d656d6f72792e736166652d76616c75652e7631057663746c6c5f6b335f6368"
  let part2: String = "65636b65645f6164645f763106781e63746c6c2e666978747572652e6b332d636865636b65642d6164642e76310701088301010209030a000b84830083850001018000850101018001850201028002820184020102038301828503020182000100850403"
  let part3: String = "0381030082028104830282850504048002850605038105008202810683038285070404800385080503810700820281080c838501020101018502030102018503040102010d8186010100010203"
  return Bytes.fromHex(part1 + part2 + part3)
}

pure flow refuseCTLLR1Wire(
  failureId: String,
  reasonText: String,
  mismatchOffset: Int,
  consumed: Int,
) -> CTLLR1WireDecision
contract { intent { "Return a stable terminal refusal without interpreting unadmitted bytes." } }
{
  return {
    verdict: Verdict.Deny
    status: "REFUSED"
    failureId: failureId
    reason: reasonText
    mismatchOffset: mismatchOffset
    consumed: consumed
    expectedLength: 277
    bodySha256: ""
  }
}

pure flow validateCTLLR1CanonicalBody(candidate: Bytes) -> CTLLR1WireDecision
contract {
  intent { "Admit only the exact bounded canonical CTLL R1 semantic-body vector and reject all drift." }
}
{
  let expected: Bytes = ctllR1CanonicalReferenceBytes()
  if expected.length() != 277 {
    return refuseCTLLR1Wire(
      "CTLL-R1-CBOR-VALIDATE-001",
      "internal canonical reference is unavailable or corrupt",
      -1,
      0,
    )
  }

  if candidate.length() < expected.length() {
    return refuseCTLLR1Wire(
      "CTLL-R1-CBOR-VALIDATE-002",
      "canonical body is truncated",
      candidate.length(),
      candidate.length(),
    )
  }
  if candidate.length() > expected.length() {
    return refuseCTLLR1Wire(
      "CTLL-R1-CBOR-VALIDATE-003",
      "canonical body contains trailing or surplus bytes",
      expected.length(),
      expected.length(),
    )
  }

  mut i: Int = 0
  while i < expected.length() {
    let actualItem = candidate.get(i)
    let expectedItem = expected.get(i)
    mut same: Bool = false
    match actualItem {
      Some(actualByte) => {
        match expectedItem {
          Some(expectedByte) => { same = actualByte == expectedByte }
          None => {}
          _ => {}
        }
      }
      None => {}
      _ => {}
    }
    if same == false {
      return refuseCTLLR1Wire(
        "CTLL-R1-CBOR-VALIDATE-004",
        "canonical body differs from the admitted R1 semantic vector",
        i,
        i,
      )
    }
    i = i + 1
  }

  return {
    verdict: Verdict.Allow
    status: "ADMITTED"
    failureId: "NONE"
    reason: "exact canonical CTLL R1 semantic body admitted"
    mismatchOffset: -1
    consumed: expected.length()
    expectedLength: expected.length()
    bodySha256: "sha256:19843a946cf68b2365cf661c278d52e4ca2b54a4230ae59e024205c0e583664d"
  }
}
