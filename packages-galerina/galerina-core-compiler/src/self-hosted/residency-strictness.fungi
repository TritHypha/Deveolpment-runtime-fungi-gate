@version 1

/// Map an exact residency tier to its strictness rank. Unknown text maps to
/// the closed sentinel rank 5, which the public flow must reject.
pure flow residencyRank(value: String) -> Int
contract { intent { "Map an exact residency tier to a rank and isolate unknown text as a sentinel." } }
{
  match value {
    "register_only" => return 0
    "no_dram_spill" => return 1
    "no_swap" => return 2
    "no_disk" => return 3
    "unrestricted" => return 4
    _ => return 5
  }
}

/// Compare two already-bounded ranks using the physical profile's admitted
/// conditional form.
pure flow rankAtMost(left: Int, right: Int) -> Bool
contract { intent { "Return whether one admitted residency rank is no greater than another." } }
{
  if left <= right {
    return true
  }
  return false
}

/// Return true only when both exact tiers are admitted and the first tier is
/// at least as strict as the required floor. Unknown text fails closed.
pure flow atLeastAsStrictFungi(tier: String, floor: String) -> Bool
contract { intent { "Compare two exact residency ceilings without admitting unknown tiers." } }
{
  let tierRank: Int = residencyRank(tier)
  let floorRank: Int = residencyRank(floor)
  if tierRank >= 5 or floorRank >= 5 {
    return false
  }
  return rankAtMost(tierRank, floorRank)
}
