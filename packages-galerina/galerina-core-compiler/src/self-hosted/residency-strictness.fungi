@version 1

/// Admit only the five exact memory-residency ceiling names.
pure flow isResidencyTier(value: String) -> Bool
contract { intent { "Recognize one exact residency tier without normalization or defaults." } }
{
  match value {
    "register_only" => return true
    "no_dram_spill" => return true
    "no_swap" => return true
    "no_disk" => return true
    "unrestricted" => return true
    _ => return false
  }
}

/// Map an already-admitted residency tier to its strictness rank.
pure flow residencyRank(value: String) -> Int
contract { intent { "Map an admitted residency tier to its closed strictness rank." } }
{
  match value {
    "register_only" => return 0
    "no_dram_spill" => return 1
    "no_swap" => return 2
    "no_disk" => return 3
    "unrestricted" => return 4
    _ => return 5
  }
}

/// Return true only when both exact tiers are admitted and the first tier is
/// at least as strict as the required floor. Unknown text fails closed.
pure flow atLeastAsStrictFungi(tier: String, floor: String) -> Bool
contract { intent { "Compare two exact residency ceilings without admitting unknown tiers." } }
{
  if isResidencyTier(tier) == false {
    return false
  }
  if isResidencyTier(floor) == false {
    return false
  }
  return residencyRank(tier) <= residencyRank(floor)
}
