@version 1
/// @file: slide-r1-reference-runtime.fungi
/// @purpose: Execute the closed typed-ID R1 profile only after structural byte admission.
/// @status: Detached first-fixture reference executor; not a native or general GIR runtime.
///
/// Tests combine this file only with the independent importer. It has no
/// source, AST, lexer, parser, adapter, WAT, Wasm, cache, or ambient registry
/// input. The structurally validated profile fixes the registered operation
/// graph; this runtime supplies its executable semantics.

record SLIDER1ReferenceResult {
  status: String
  success: Bool
  value: Int
  failureId: Int
  importFailureId: String
}

// Leave the execution path when structural byte admission is not ALLOW.
pure flow refuseSLIDER1ReferenceImport(failureId: String) -> SLIDER1ReferenceResult
contract { intent { "Leave the execution path when structural byte admission is not ALLOW." } }
{
  return {
    status: "IMPORT_REFUSED"
    success: false
    value: 0
    failureId: 0
    importFailureId: failureId
  }
}

// Return one declared typed R1 failure and no success value.
pure flow failSLIDER1Reference(failureId: Int) -> SLIDER1ReferenceResult
contract { intent { "Return one declared typed R1 failure and no success value." } }
{
  return {
    status: "FAILED"
    success: false
    value: 0
    failureId: failureId
    importFailureId: "NONE"
  }
}

// Reference-execute the exact imported checked-add/K3 graph with total terminal outcomes.
pure flow executeSLIDER1Imported(
  body: Bytes,
  left: Int,
  right: Int,
  admission: Verdict,
) -> SLIDER1ReferenceResult
contract {
  intent { "Reference-execute the exact imported checked-add/K3 graph with total terminal outcomes." }
}
{
  let imported = validateSLIDER1StructuralBody(body)
  if imported.verdict != Verdict.Allow {
    return refuseSLIDER1ReferenceImport(imported.failureId)
  }

  check(admission) {
    deny: { return failSLIDER1Reference(2) }
    ambig: { return failSLIDER1Reference(3) }
    if: {
      if right > 0 and left > 2147483647 - right {
        return failSLIDER1Reference(1)
      }
      if right < 0 and left < -2147483648 - right {
        return failSLIDER1Reference(1)
      }
      return {
        status: "OK"
        success: true
        value: left + right
        failureId: 0
        importFailureId: "NONE"
      }
    }
  }
}
