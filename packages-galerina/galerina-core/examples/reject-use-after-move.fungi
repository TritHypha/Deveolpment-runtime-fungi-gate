@version 1
// EXPECT: ACCEPT
// AREA: memory
// PURPOSE: legacy filename retained to document that Rust-style use-after-move
//          rejection is not part of Galerina's value-semantics model.

type Payload {
  data: String
}

/// Sends a payload value without invalidating the caller's binding.
secure flow sendPayload(p: Payload) -> Result<Void, String>
contract {
  intent { "Transmit one payload through the admitted external network effect." }
  effects { network.external }
}
{
  return transmit(p.data)
}

/// The second read is valid: Galerina has value semantics and no raw aliases.
secure flow demonstrateLegacyFilename() -> Result<Void, String>
contract {
  intent { "Prove the legacy use-after-move filename now teaches value semantics." }
  effects { network.external }
}
{
  let payload: Payload = Payload { data: "hello" }

  sendPayload(payload)
  return transmit(payload.data)
}
