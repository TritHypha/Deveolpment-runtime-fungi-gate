@version 1
// Worker counts, queues, and dead-letter paths belong to an admitted deployment
// manifest. The portable language core only decides how an event is classified.

type OrderEvent {
  id: String
  type: String
}

pure flow orderAction(order: OrderEvent) -> String {
  match order.type {
    "created" => return "process"
    "cancelled" => return "cancel"
    _ => return "dead-letter"
  }
}
