@version 1
// EXPECT: ACCEPT
// AREA: memory
// PURPOSE: resource is moved to a handler; handler holds sole ownership and performs cleanup

type Connection {
  host: String
  port: Int
}

enum ConnectionError {
  Timeout
  Refused
  Closed
}

/// Closes a connection value. Resource uniqueness is enforced by the admitted
/// host capability, not a source-level move annotation.
secure flow closeConnection(conn: Connection) -> Result<Void, ConnectionError>
contract {
  intent { "Close one admitted connection and return the terminal result." }
  effects { network.external }
}
{
  let result: Result<Void, ConnectionError> = performClose(conn.host, conn.port)
  return result
}

/// Opens a connection value and delegates terminal cleanup.
secure flow connectAndClose(host: String, port: Int) -> Result<Void, ConnectionError>
contract {
  intent { "Open one admitted connection and close it before returning." }
  effects { network.external }
}
{
  let conn: Connection = Connection { host: host, port: port }
  return closeConnection(conn)
}
