@version 1
// EXPECT: ACCEPT
// AREA: api
// PURPOSE: webhook declaration with HMAC security, JSON decode, and typed handler
type PaymentEvent {
  id: String
  type: String
  orderId: String
}

// Path, HMAC key binding, replay window, body ceiling, and idempotency key are
// admitted host-manifest data. Source code cannot mint those capabilities.

secure flow handlePaymentWebhook(req: Request) -> Result<Response, WebhookError>
contract {
  intent { "Dispatch one host-verified payment webhook by admitted event type." }
  effects { network.inbound }
}
{
  let event: PaymentEvent = json.decode<PaymentEvent>(req.body)

  match event.type {
    "payment.succeeded" => handlePaymentSucceeded(event)
    "payment.failed"    => handlePaymentFailed(event)
    _ => return JsonResponse("ignored")
  }

  return JsonResponse("received")
}
