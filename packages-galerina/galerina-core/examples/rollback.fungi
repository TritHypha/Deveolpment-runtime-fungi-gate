@version 1
// EXPECT: ACCEPT
// AREA: api
// PURPOSE: checkpoint and rollback for transactional flows
type Order {
  id: String
}

enum OrderError {
  PaymentFailed
  StockUnavailable
}

// Transaction checkpoints and compensating actions are admitted host
// resources. The portable flow exposes one terminal Result and never resumes
// after an error.
secure flow completeOrder(order: Order) -> Result<Order, OrderError>
contract { intent { "Complete stock, payment, and dispatch as one governed order operation." } }
{
  reserveStock(order)
  takePayment(order)
  dispatchOrder(order)

  return Ok(order)
}
