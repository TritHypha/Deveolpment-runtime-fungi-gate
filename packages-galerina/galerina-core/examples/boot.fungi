@version 1
// Portable boot-policy decision surface.
//
// Project metadata, entry paths, drivers, permissions, memory ceilings,
// targets, documentation outputs, and signing manifests are data in the
// admitted boot manifest. They are not executable top-level declarations and
// cannot mint authority from source code. A present device with no admitted
// driver remains present-but-unusable.

record BootPolicy {
  strictTypes: Bool
  denyNull: Bool
  denyImplicitCasts: Bool
  denySecretLogging: Bool
  deterministicBuild: Bool
}

record HardwareAdmission {
  present: Bool
  driverAdmitted: Bool
  contractAdmitted: Bool
}

pure flow defaultBootPolicy() -> BootPolicy {
  return BootPolicy {
    strictTypes: true
    denyNull: true
    denyImplicitCasts: true
    denySecretLogging: true
    deterministicBuild: true
  }
}

pure flow hardwareUsable(admission: HardwareAdmission) -> Bool {
  match admission.present {
    false => return false
    true => {
      match admission.driverAdmitted {
        false => return false
        true => return admission.contractAdmitted
        _ => return false
      }
    }
    _ => return false
  }
}

pure flow targetAllowed(targetName: String, admission: HardwareAdmission) -> Bool {
  match hardwareUsable(admission) {
    false => return false
    true => {
      match targetName {
        "cpu" => return true
        "gpu" => return true
        "photonic" => return true
        "ternary" => return true
        _ => return false
      }
    }
    _ => return false
  }
}
