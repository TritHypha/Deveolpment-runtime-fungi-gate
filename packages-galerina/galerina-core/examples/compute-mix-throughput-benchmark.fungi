@version 1
// Portable admission contract for the archived compute-mix benchmark.
//
// The historical Node.js and Python implementations remain available as
// evidence, but this `.fungi` source does not claim native or SLIDE execution.
// Cross-runtime publication waits for an executable SLIDE backend.

type ComputeMixBenchmarkRequest {
  targetMs: Int
  warmupMs: Int
  batchSize: Int
}

enum ComputeMixBenchmarkError {
  InvalidTargetMs
  InvalidWarmupMs
  InvalidBatchSize
}

pure flow validateComputeMixRequest(
request: ComputeMixBenchmarkRequest
) -> Result<ComputeMixBenchmarkRequest, ComputeMixBenchmarkError> {
  match request.targetMs {
    when request.targetMs < 10000 => return Err(ComputeMixBenchmarkError.InvalidTargetMs)
    when request.targetMs > 30000 => return Err(ComputeMixBenchmarkError.InvalidTargetMs)
    _ => {
      match request.warmupMs {
        when request.warmupMs < 0 => return Err(ComputeMixBenchmarkError.InvalidWarmupMs)
        _ => {
          match request.batchSize {
            when request.batchSize <= 0 => return Err(ComputeMixBenchmarkError.InvalidBatchSize)
            _ => return Ok(request)
          }
        }
      }
    }
  }
}
