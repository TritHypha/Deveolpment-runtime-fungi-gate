@version 1
// Local-only request admission for the archived four-digit search fixture.
// The portable language does not expose a brute-force loop or runtime metrics
// as a benchmark claim; execution remains host-owned until SLIDE is executable.

record FourDigitGuessRequest {
  codeLength: Int
  maxAttempts: Int
}

enum FourDigitGuessError {
  InvalidCodeLength
  InvalidMaxAttempts
  MaxAttemptsTooHigh
}

pure flow validateFourDigitGuessRequest(
request: FourDigitGuessRequest
) -> Result<FourDigitGuessRequest, FourDigitGuessError> {
  match request.codeLength {
    4 => {
      match request.maxAttempts {
        when request.maxAttempts <= 0 => return Err(FourDigitGuessError.InvalidMaxAttempts)
        when request.maxAttempts > 1000000 => return Err(FourDigitGuessError.MaxAttemptsTooHigh)
        _ => return Ok(request)
      }
    }
    _ => return Err(FourDigitGuessError.InvalidCodeLength)
  }
}
