@version 1
type FraudFeatures {
  amountScore: Float
  accountAgeScore: Float
  velocityScore: Float
}

pure flow fraudModel(features: FraudFeatures) -> Float {
  return features.amountScore + features.accountAgeScore + features.velocityScore
}

pure flow scoreFraud(features: FraudFeatures) -> Float {
  // Target selection (photonic, GPU, or CPU) belongs to the admitted hardware
  // manifest. The same deterministic flow remains the reference on every lane.
  return fraudModel(features)
}
