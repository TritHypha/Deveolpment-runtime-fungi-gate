@version 1
// EXPECT: ACCEPT
// AREA: memory
// PURPOSE: immutable value input keeps the caller's owner valid

type Buffer {
  data: Array<UInt8>
  size: Int
}

/// Reads the first byte from an immutable value input.
/// Galerina uses value semantics on today's silicon; it does not expose a
/// Rust-style borrow annotation in the v1 grammar.
pure flow peekFirstByte(buf: Buffer) -> Option<UInt8> {
  if buf.size == 0 {
    return None
  }
  return Some(buf.data.get(0))
}

/// Demonstrates that the owner remains valid after a borrow ends.
flow inspectBuffer() -> Result<UInt8, String> {
  let buf: Buffer = Buffer {
    data: [0x48, 0x65, 0x6C, 0x6C, 0x6F]
    size: 5
  }

  // The caller retains its value after the immutable call.
  let firstByte: Option<UInt8> = peekFirstByte(buf)

  // buf is still fully accessible here; the borrow has ended
  match firstByte {
    Some(byte) => return Ok(byte)
    None       => return Err("buffer was empty")
    _          => return Err("unexpected match case")
  }
}
