@version 1
// EXPECT: ACCEPT
// AREA: type-system
// PURPOSE: Tri enum with pure flow and guard-clause match
enum Tri {
  Positive
  Neutral
  Negative
}

pure flow signalState(score: Float) -> Tri {
  match score {
    when score > 0.1  => return Positive
    when score < -0.1 => return Negative
    _ => return Neutral
  }
}
