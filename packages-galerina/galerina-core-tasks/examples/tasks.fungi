@version 1
// Task declarations are host manifests, not executable language syntax in v1.
// These pure dependency facts are the portable .fungi authority consumed by a
// task host after manifest admission.

pure flow reportsTaskName() -> String {
  return "generateReports"
}

pure flow buildApiDependency() -> String {
  return reportsTaskName()
}

pure flow taskOutputRoot(taskName: String) -> String {
  match taskName {
    "generateReports" => return "./build/reports"
    "buildApi" => return "./build"
    _ => return ""
  }
}
