@version 1
// Source-bound decision overlay wave 50 item 34: route-registry.ts#RouteEntry.
pure flow routeRegistryRouteEntryStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if policyReady {
        if routeReady {
          if proofReady {
            if sealReady {
              if stateReady { return "route_registry_route_entry_built" }
              return "wave50_state_missing"
            }
            return "wave50_seal_missing"
          }
          return "wave50_proof_missing"
        }
        return "wave50_route_missing"
      }
      return "wave50_policy_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
