@version 1
// Source-bound decision overlay wave 19 item 33: secret-gate-create-status.fungi.
pure flow secretGateCreateStatusCore(providerCaptured: Bool, admitBound: Bool, useBound: Bool, gateFrozen: Bool) -> String {
  let sourceProofA: Bool = providerCaptured
  let sourceProofB: Bool = useBound
  let sourceProofC: Bool = providerCaptured
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if admitBound {
          if useBound {
            if providerCaptured {
              if gateFrozen {
                return "secret_gate_created"
              }
              return "gateFrozen_missing"
            }
            return "providerCaptured_missing"
          }
          return "useBound_missing"
        }
        return "admitBound_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
