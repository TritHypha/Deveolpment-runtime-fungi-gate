pure flow registryAuthorityBuildStatusCore(inputCaptured: Bool, fieldsValidated: Bool, operationalValid: Bool, objectBuilt: Bool, frozen: Bool) -> String {
  let sourceProofA: Bool = fieldsValidated
  let sourceProofB: Bool = inputCaptured
  if sourceProofA {
    if sourceProofB {
      if objectBuilt {
        if fieldsValidated {
          if operationalValid {
            if frozen {
              if inputCaptured {
