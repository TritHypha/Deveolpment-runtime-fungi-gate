@version 1
// Source-bound decision overlay wave 50 item 1: resilience-inference.ts#hasExplicitResilience.
pure flow resilienceInferenceHasExplicitResilienceStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if stateReady {
        if policyReady {
          if routeReady {
            if proofReady {
              if sealReady { return "resilience_inference_has_explicit_resilience_built" }
              return "wave50_seal_missing"
            }
            return "wave50_proof_missing"
          }
          return "wave50_route_missing"
        }
        return "wave50_policy_missing"
      }
      return "wave50_state_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
