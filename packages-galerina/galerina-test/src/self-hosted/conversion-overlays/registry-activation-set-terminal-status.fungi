pure flow registryActivationSetTerminalStatusCore(stateCaptured: Bool, boundaryCaptured: Bool, authorityMatched: Bool, terminalSelected: Bool, stateUpdated: Bool) -> String {
  let sourceProofA: Bool = terminalSelected
  let sourceProofB: Bool = stateCaptured
  if sourceProofA {
    if sourceProofB {
      if terminalSelected {
        if stateUpdated {
          if stateCaptured {
            if authorityMatched {
              if boundaryCaptured {
                return "registry_activation_terminal_set"
              }
              return "boundaryCaptured_missing"
            }
            return "authorityMatched_missing"
          }
          return "stateCaptured_missing"
        }
        return "stateUpdated_missing"
