@version 1
pure flow sporeSchemaVersionStatusCore(valueExact: Bool, schemaBound: Bool, containerIndependent: Bool) -> String {
  let evidence01: Bool = valueExact
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
