@version 1
/// Credential diagnostic core of db-mysql#index.ts#validateMysqlCredentialRef after String inspection.
pure flow mysqlCredentialValidationMask(kindFault: Int, referenceFault: Int, inlineCredentialFault: Int) -> Int
contract { intent { "Reject non-external credentials, empty references, and inline secrets independently." } }
{
  return kindFault + (referenceFault + inlineCredentialFault * 2) * 2
}
