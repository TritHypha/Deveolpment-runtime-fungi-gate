@version 1
// Source-bound decision overlay wave 19 item 32: secret-gate-admit-status.fungi.
pure flow secretGateAdmitStatusCore(requiredCaptured: Bool, providerBound: Bool, secretsChecked: Bool, decisionBound: Bool) -> String {
  let sourceProofA: Bool = decisionBound
  let sourceProofB: Bool = providerBound
  let sourceProofC: Bool = decisionBound
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if providerBound {
          if requiredCaptured {
            if decisionBound {
              if secretsChecked {
                return "secret_gate_admission_resolved"
              }
              return "secretsChecked_missing"
            }
            return "decisionBound_missing"
          }
          return "requiredCaptured_missing"
        }
        return "providerBound_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
