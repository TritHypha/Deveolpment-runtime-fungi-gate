@version 1
pure flow sporeCliParseArgsStatusCore(argvCaptured: Bool, defaultsReady: Bool, flagsParsed: Bool, restCaptured: Bool) -> String {
  let evidence01: Bool = argvCaptured
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  let evidence09: Bool = evidence08
  let evidence10: Bool = evidence09
  let evidence11: Bool = evidence10
  let argvReady: Bool = argvCaptured
  if evidence11 { if defaultsReady { let parsed: Bool = flagsParsed if parsed { let restReady: Bool = restCaptured if restReady { return "args_parsed" } return "rest_missing" } return "flags_invalid" } return "defaults_missing" } return "argv_missing"
}
