@version 1
pure flow vaultCredentialRotateFacadeStatusCore(credentialCaptured: Bool, clientBound: Bool, rotationCompleted: Bool) -> String {
  let evidence01: Bool = credentialCaptured
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  if evidence06 { let bound: Bool = clientBound if bound { let done: Bool = rotationCompleted if done { return "credential_rotated" } return "rotation_failed" } return "client_unbound" } return "credential_missing"
}
