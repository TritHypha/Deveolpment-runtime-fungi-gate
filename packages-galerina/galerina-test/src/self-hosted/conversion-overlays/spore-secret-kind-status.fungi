@version 1
pure flow sporeSecretKindStatusCore(valueExact: Bool, domainBound: Bool) -> String {
  let valueReady: Bool = valueExact
  let domainReady: Bool = domainBound
  let kindReady: Bool = valueReady
  let sectionReady: Bool = kindReady
  let secretReady: Bool = domainReady
  let tagReady: Bool = sectionReady
  let releaseReady: Bool = secretReady
  let outputReady: Bool = tagReady
  let finalReady: Bool = releaseReady
  if outputReady { if finalReady { return "secret_kind" } return "domain_refused" } return "value_refused"
}
