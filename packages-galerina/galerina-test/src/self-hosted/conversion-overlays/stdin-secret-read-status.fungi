@version 1
/// EOF read, CRLF trimming and source-buffer cleanup status.
pure flow stdinSecretReadStatusCore(eofReached: Bool, trailingLf: Bool, trailingCr: Bool, sourceWiped: Bool) -> String {
  if eofReached {
    if sourceWiped {
      if trailingLf {
        if trailingCr { return "crlf_stripped_wiped" }
        return "lf_stripped_wiped"
      }
      return "raw_wiped"
    }
    return "source_not_wiped"
  }
  return "read_incomplete"
}
