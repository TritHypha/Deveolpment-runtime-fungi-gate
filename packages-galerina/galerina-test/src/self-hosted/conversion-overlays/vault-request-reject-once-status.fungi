@version 1
pure flow vaultRequestRejectOnceStatusCore(unsettled: Bool, errorCaptured: Bool, rejected: Bool) -> String {
  let evidence01: Bool = unsettled
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  let evidence09: Bool = evidence08
  if evidence09 { let errorReady: Bool = errorCaptured if errorReady { let rejectionReady: Bool = rejected if rejectionReady { return "request_rejected_once" } return "reject_failed" } return "error_missing" } return "already_settled"
}
