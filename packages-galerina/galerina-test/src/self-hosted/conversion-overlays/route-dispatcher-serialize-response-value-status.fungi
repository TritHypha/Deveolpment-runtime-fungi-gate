@version 1
// Source-bound decision overlay wave 50 item 30: route-dispatcher.ts#serializeResponseValue.
pure flow routeDispatcherSerializeResponseValueStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if policyReady {
        if stateReady {
          if sealReady {
            if routeReady {
              if proofReady { return "route_dispatcher_serialize_response_value_built" }
              return "wave50_proof_missing"
            }
            return "wave50_route_missing"
          }
          return "wave50_seal_missing"
        }
        return "wave50_state_missing"
      }
      return "wave50_policy_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
