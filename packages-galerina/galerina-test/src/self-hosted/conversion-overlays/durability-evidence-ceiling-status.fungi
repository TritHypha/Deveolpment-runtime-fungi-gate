@version 1
// Source-bound decision overlay wave 20 item 22: durability-evidence-ceiling-status.fungi.
pure flow durabilityEvidenceCeilingStatusCore(recordCaptured: Bool, classBound: Bool, claimsChecked: Bool, ceilingHeld: Bool) -> String {
  let sourceProofA: Bool = claimsChecked
  let sourceProofB: Bool = claimsChecked
  let sourceProofC: Bool = ceilingHeld
  let waveSealA: Bool = sourceProofA
  if waveSealA {
    if sourceProofB {
      if sourceProofC {
        if recordCaptured {
          if claimsChecked {
            if classBound {
              if ceilingHeld {
                return "durability_evidence_claim_ceiling_held"
              }
              return "ceilingHeld_missing"
            }
            return "classBound_missing"
          }
          return "claimsChecked_missing"
        }
        return "recordCaptured_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "waveSealA_missing"
}
