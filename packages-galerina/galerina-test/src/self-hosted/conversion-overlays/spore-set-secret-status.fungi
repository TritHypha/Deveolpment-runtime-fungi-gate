@version 1
/// Binds name, coordinate, metadata and secret bytes at the set operation.
pure flow sporeSetSecretStatusCore(nameCaptured: Bool, coordinateDerived: Bool, metadataBound: Bool, valueStored: Bool) -> String {
  let nameReady: Bool = nameCaptured
  if nameReady {
    let coordinateReady: Bool = coordinateDerived
    if coordinateReady {
      let metadataReady: Bool = metadataBound
      if metadataReady {
        if valueStored { return "secret_set" }
        return "store_failed"
      }
      return "metadata_failed"
    }
    return "coordinate_failed"
  }
  return "name_missing"
}
