@version 1
// Source-bound decision overlay wave 19 item 2: host-floor-registry-runtime-status.fungi.
pure flow hostFloorRegistryRuntimeStatusCore(importsStarted: Bool, modulesLoaded: Bool, capabilitiesBound: Bool, floorFrozen: Bool) -> String {
  let sourceProofA: Bool = modulesLoaded
  let sourceProofB: Bool = floorFrozen
  let sourceProofC: Bool = modulesLoaded
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if importsStarted {
          if modulesLoaded {
            if capabilitiesBound {
              if floorFrozen {
                return "host_floor_registry_runtime_loaded"
              }
              return "floorFrozen_missing"
            }
            return "capabilitiesBound_missing"
          }
          return "modulesLoaded_missing"
        }
        return "importsStarted_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
