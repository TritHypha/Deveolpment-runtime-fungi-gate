@version 1
/// Closed discriminant selector of core-config#index.ts#isSecretConfigSourceKind.
pure flow secretConfigSourceKindCore(kind: String) -> Bool
contract { intent { "Recognize only the four core secret configuration source kinds." } }
{
  if kind == "env" { return true }
  match kind {
    "vault" => return true
    "kms" => return true
    "runtime" => return true
    _ => return false
  }
}
