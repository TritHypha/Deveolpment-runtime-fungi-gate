@version 1
// Source-bound decision overlay wave 50 item 21: route-dispatcher.ts#RunningServer.
pure flow routeDispatcherRunningServerStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if stateReady {
        if sealReady {
          if proofReady {
            if routeReady {
              if policyReady { return "route_dispatcher_running_server_built" }
              return "wave50_policy_missing"
            }
            return "wave50_route_missing"
          }
          return "wave50_proof_missing"
        }
        return "wave50_seal_missing"
      }
      return "wave50_state_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
