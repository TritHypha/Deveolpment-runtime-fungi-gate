{
  "name": "@galerina/devtools-benchmarks",
  "version": "1.0.0-beta.2",
  "description": "Runtime comparison benchmarks: Python · Node.js · C++ · Rust · Galerina (governed + manifest)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageGraph": {
    "roots": [
      "src",
      "contracts",
      "evidence"
    ],
    "extensions": [
      ".ts",
      ".fungi",
      ".mjs",
      ".js",
      ".json"
    ],
    "entryPoints": [
      "src/audit-benchmark-integrity.mjs",
      "src/audit-slide-vade.mjs",
      "src/audit.mjs",
      "src/bench-guard.mjs",
      "src/build-chart.mjs",
      "src/build-native.mjs",
      "src/chart.mjs",
      "src/compare-chart.mjs",
      "src/compare.mjs",
      "src/diagnostic-runner.mjs",
      "src/history.mjs",
      "src/noise-gate.mjs",
      "src/report.mjs",
      "src/runner.mjs",
      "src/slide-vade-adapter.mjs",
      "src/snapshot.mjs",
      "src/variance.mjs"
    ],
    "loadedAssets": [
      "contracts/slide-v2g-vade-admission-v1.json",
      "evidence/slide-v2g-verified-ahead-of-demand-b5aab13.json",
      "src/wasm-runner.mjs"
    ],
    "allowOrphans": [
      {
        "path": "src/mem-sampler.mjs",
        "reason": "Dormant exported sampler retained for benchmark instrumentation; no executable or import currently owns it."
      }
    ]
  },
  "scripts": {
    "run": "node --expose-gc src/runner.mjs",
    "run:quick": "node --expose-gc src/runner.mjs --quick",
    "run:compute-mix": "node --expose-gc src/runner.mjs --benchmark compute-mix",
    "run:arithmetic": "node --expose-gc src/runner.mjs --benchmark arithmetic-threshold",
    "run:guess": "node --expose-gc src/runner.mjs --benchmark six-digit-guess",
    "run:hardware-targets": "node --expose-gc src/runner.mjs --benchmark hardware-targets",
    "run:governance-cost": "node --expose-gc src/runner.mjs --benchmark governance-cost",
    "run:call-chain": "node --expose-gc src/runner.mjs --benchmark call-chain",
    "run:passive": "node --expose-gc src/runner.mjs --benchmark hardware-targets",
    "run:http": "node benchmarks/http-throughput/benchmark.mjs",
    "compare": "node src/compare.mjs",
    "report": "node src/report.mjs",
    "chart": "node src/chart.mjs",
    "ui": "node src/build-chart.mjs",
    "compare-ui": "node src/compare-chart.mjs",
    "ui:full": "node --expose-gc src/runner.mjs && node src/build-chart.mjs",
    "variance": "node src/variance.mjs",
    "noise-gate": "node src/noise-gate.mjs",
    "noise-gate:selftest": "node src/noise-gate.mjs --self-test",
    "admit:slide-vade": "node src/slide-vade-adapter.mjs",
    "build:native": "node src/build-native.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node src/audit-slide-vade.mjs && node --expose-gc src/audit.mjs",
    "audit:slide-vade": "node src/audit-slide-vade.mjs",
    "audit:slide-vade:selftest": "node src/audit-slide-vade.mjs --self-test",
    "snapshot": "node src/snapshot.mjs",
    "bench": "node --expose-gc src/runner.mjs --quick && node src/compare.mjs && npm run audit",
    "run:diagnostic": "node src/diagnostic-runner.mjs",
    "run:diagnostic-suite": "node --expose-gc src/runner.mjs --diagnostic",
    "run:fault-injection": "node src/diagnostic-runner.mjs --benchmark toxic-input --benchmark governance-violation",
    "history": "node src/history.mjs",
    "bench:guard": "node src/bench-guard.mjs"
  },
  "dependencies": {
    "@galerina/core-compiler": "file:../galerina-core-compiler"
  },
  "engines": {
    "node": ">=18"
  }
}
