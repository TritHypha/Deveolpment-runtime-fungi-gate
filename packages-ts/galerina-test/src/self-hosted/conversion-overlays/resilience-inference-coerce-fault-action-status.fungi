@version 1
// Source-bound decision overlay wave 50 item 10: resilience-inference.ts#coerceFaultAction.
pure flow resilienceInferenceCoerceFaultActionStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if stateReady {
        if routeReady {
          if proofReady {
            if sealReady {
              if policyReady { return "resilience_inference_coerce_fault_action_built" }
              return "wave50_policy_missing"
            }
            return "wave50_seal_missing"
          }
          return "wave50_proof_missing"
        }
        return "wave50_route_missing"
      }
      return "wave50_state_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
