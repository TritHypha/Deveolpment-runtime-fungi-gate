@version 1
/// GCM structural refusal, callback containment and wipe fold.
pure flow recipientSecretUnwrapStatusCore(ciphertextLongEnough: Bool, tagReady: Bool, decryptFinal: Bool, callbackContained: Bool, intermediatesWiped: Bool) -> String {
  let admittedCiphertext: Bool = ciphertextLongEnough
  let admittedTag: Bool = tagReady
  if admittedCiphertext {
    if admittedTag {
      if decryptFinal {
        if callbackContained {
          if intermediatesWiped { return "unwrapped_wiped" }
          return "wipe_missing"
        }
        return "callback_escape"
      }
      return "decrypt_failed"
    }
    return "tag_refused"
  }
  return "ciphertext_refused"
}
