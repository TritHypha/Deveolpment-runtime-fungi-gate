@version 1
/// Validates the closed secret metadata record in source order.
pure flow sporeSecretMetaValidationStatusCore(recordExact: Bool, coordinateValid: Bool, timesValid: Bool, profileValid: Bool) -> String {
  let shapeReady: Bool = recordExact
  if shapeReady {
    let coordinateReady: Bool = coordinateValid
    if coordinateReady {
      let clockReady: Bool = timesValid
      if clockReady {
        let suiteReady: Bool = profileValid
        if suiteReady { return "secret_meta_valid" }
        return "profile_invalid"
      }
      return "times_invalid"
    }
    return "coordinate_invalid"
  }
  return "record_invalid"
}
