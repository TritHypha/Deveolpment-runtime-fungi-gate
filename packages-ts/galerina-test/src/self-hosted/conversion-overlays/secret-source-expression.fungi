@version 1
/// Post-capture decision core of value-state-checker.ts#isSecretSourceExpression.
pure flow secretSourceExpressionCore(errorPropagation: Bool, innerSecret: Bool, callExpression: Bool, secretNs: Bool, secretsNs: Bool, vaultNs: Bool, kmsNs: Bool) -> Bool
contract { intent { "Preserve error-propagation recursion before closed secret namespace classification." } }
{
  if errorPropagation { return innerSecret }
  if callExpression {
    if secretNs { return true }
    if secretsNs { return true }
    if vaultNs { return true }
    return kmsNs
  }
  return false
}
