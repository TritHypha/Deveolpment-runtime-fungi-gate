@version 1
// Source-bound decision overlay wave 50 item 5: resilience-inference.ts#extractRetryCount.
pure flow resilienceInferenceExtractRetryCountStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if stateReady {
        if policyReady {
          if sealReady {
            if proofReady {
              if routeReady { return "resilience_inference_extract_retry_count_built" }
              return "wave50_route_missing"
            }
            return "wave50_proof_missing"
          }
          return "wave50_seal_missing"
        }
        return "wave50_policy_missing"
      }
      return "wave50_state_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
