@version 1
pure flow sporeCliDieStatusCore(messageCaptured: Bool, newlineReady: Bool, exitCodeReady: Bool) -> String {
  let evidence01: Bool = messageCaptured
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  let evidence09: Bool = evidence08
  let evidence10: Bool = evidence09
  let evidence11: Bool = evidence10
  let evidence12: Bool = evidence11
  if evidence12 { let lineReady: Bool = newlineReady let codeReady: Bool = exitCodeReady if lineReady { if codeReady { return "fatal_emitted" } return "exit_code_missing" } return "newline_missing" } return "message_missing"
}
