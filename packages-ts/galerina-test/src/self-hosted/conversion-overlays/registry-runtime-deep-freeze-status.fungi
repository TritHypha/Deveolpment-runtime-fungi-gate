@version 1
// Source-bound decision overlay wave 17 item 18: registry-runtime-deep-freeze-status.fungi.
pure flow registryRuntimeDeepFreezeStatusCore(valueCaptured: Bool, childrenVisited: Bool, objectFrozen: Bool, graphSealed: Bool) -> String {
  let sourceProofA: Bool = graphSealed
  let sourceProofB: Bool = objectFrozen
  if sourceProofA {
    if sourceProofB {
      if graphSealed {
        if childrenVisited {
          if valueCaptured {
            if objectFrozen {
              return "registry_runtime_graph_frozen"
            }
            return "objectFrozen_missing"
          }
          return "valueCaptured_missing"
        }
        return "childrenVisited_missing"
      }
      return "graphSealed_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
