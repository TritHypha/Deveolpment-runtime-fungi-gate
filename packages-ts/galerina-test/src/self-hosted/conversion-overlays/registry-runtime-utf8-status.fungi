// Source-bound decision overlay wave 17 item 13: registry-runtime-utf8-status.fungi.
pure flow registryRuntimeUtf8StatusCore(bytesCaptured: Bool, nonEmpty: Bool, decoded: Bool, noReplacement: Bool) -> String {
