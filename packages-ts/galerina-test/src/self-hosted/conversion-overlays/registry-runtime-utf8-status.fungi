  let sourceProofB: Bool = nonEmpty
  let sourceProofC: Bool = noReplacement
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if bytesCaptured {
          if nonEmpty {
            if decoded {
              if noReplacement {
                return "registry_runtime_utf8_decoded"
