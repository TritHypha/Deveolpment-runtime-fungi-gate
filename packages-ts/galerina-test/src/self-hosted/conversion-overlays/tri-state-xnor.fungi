@version 1
/// Closed K3 value core of core-logic/tri-ops.ts#triStateXnor; reason aggregation stays at the host border.
pure flow triStateXnorCore(left: Verdict, right: Verdict) -> Verdict
contract { intent { "Return equality for determinate K3 values and preserve ambiguity otherwise." } }
{
  check(left) {
    deny: {
      check(right) {
        deny: { return Verdict.Allow }
        ambig: { return Verdict.Unknown }
        if: { return Verdict.Deny }
      }
    }
    ambig: { return Verdict.Unknown }
    if: {
      check(right) {
        deny: { return Verdict.Deny }
        ambig: { return Verdict.Unknown }
        if: { return Verdict.Allow }
      }
    }
  }
}
