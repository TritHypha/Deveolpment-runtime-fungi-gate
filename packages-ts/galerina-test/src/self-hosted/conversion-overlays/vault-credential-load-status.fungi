@version 1
/// Loads a fresh Vault value only after the prior buffers are wiped.
pure flow vaultCredentialLoadStatusCore(secretFetched: Bool, oldFound: Bool, oldWiped: Bool, handleStored: Bool) -> String {
  if secretFetched {
    if oldFound {
      if oldWiped {
        if handleStored { return "credential_loaded" }
        return "handle_store_failed"
      }
      return "old_value_live"
    }
    if handleStored { return "credential_loaded" }
    return "new_handle_store_failed"
  }
  return "fetch_failed"
}
