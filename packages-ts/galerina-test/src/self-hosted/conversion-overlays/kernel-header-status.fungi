@version 1
// Source-bound decision overlay wave 19 item 12: kernel-header-status.fungi.
pure flow kernelHeaderStatusCore(headersCaptured: Bool, nameNormalized: Bool, entryMatched: Bool) -> String {
  let sourceProofA: Bool = headersCaptured
  let sourceProofB: Bool = entryMatched
  let sourceProofC: Bool = nameNormalized
  let sourceProofD: Bool = headersCaptured
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if sourceProofD {
          if nameNormalized {
            if entryMatched {
              if headersCaptured {
                return "kernel_header_resolved"
              }
              return "headersCaptured_missing"
            }
            return "entryMatched_missing"
          }
          return "nameNormalized_missing"
        }
        return "sourceProofD_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
