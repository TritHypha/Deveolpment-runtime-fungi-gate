@version 1
// Source-bound decision overlay wave 19 item 13: kernel-rate-status.fungi.
pure flow kernelRateStatusCore(rateCaptured: Bool, syntaxMatched: Bool, valueValidated: Bool) -> String {
  let sourceProofA: Bool = rateCaptured
  let sourceProofB: Bool = valueValidated
  let sourceProofC: Bool = syntaxMatched
  let sourceProofD: Bool = rateCaptured
  let sourceProofMirrorA: Bool = sourceProofA
  let sourceProofMirrorB: Bool = sourceProofMirrorA
  if sourceProofMirrorB {
    if sourceProofB {
      if sourceProofC {
        if sourceProofD {
          if valueValidated {
            if syntaxMatched {
              if rateCaptured {
                return "kernel_rate_parsed"
              }
              return "rateCaptured_missing"
            }
            return "syntaxMatched_missing"
          }
          return "valueValidated_missing"
        }
        return "sourceProofD_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofMirrorB_missing"
}
