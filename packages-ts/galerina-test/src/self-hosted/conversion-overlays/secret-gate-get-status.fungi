@version 1
// Source-bound decision overlay wave 19 item 34: secret-gate-get-status.fungi.
pure flow secretGateGetStatusCore(requiredCaptured: Bool, nameCaptured: Bool, providerUsed: Bool, callbackCompleted: Bool, viewErased: Bool) -> String {
  let sourceProofA: Bool = callbackCompleted
  let sourceProofB: Bool = requiredCaptured
  if sourceProofA {
    if sourceProofB {
      if requiredCaptured {
        if providerUsed {
          if viewErased {
            if callbackCompleted {
              if nameCaptured {
                return "secret_gate_use_completed"
              }
              return "nameCaptured_missing"
            }
            return "callbackCompleted_missing"
          }
          return "viewErased_missing"
        }
        return "providerUsed_missing"
      }
      return "requiredCaptured_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
