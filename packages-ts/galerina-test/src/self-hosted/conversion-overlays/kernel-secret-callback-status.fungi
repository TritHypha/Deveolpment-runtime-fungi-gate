@version 1
// Source-bound decision overlay wave 19 item 9: kernel-secret-callback-status.fungi.
pure flow kernelSecretCallbackStatusCore(nameCaptured: Bool, callbackCaptured: Bool, secretUsed: Bool) -> String {
  let sourceProofA: Bool = secretUsed
  let sourceProofB: Bool = callbackCaptured
  let sourceProofC: Bool = nameCaptured
  let sourceProofD: Bool = secretUsed
  if sourceProofA {
    if sourceProofB {
      if sourceProofC {
        if sourceProofD {
          if callbackCaptured {
            if secretUsed {
              if nameCaptured {
                return "kernel_secret_callback_completed"
              }
              return "nameCaptured_missing"
            }
            return "secretUsed_missing"
          }
          return "callbackCaptured_missing"
        }
        return "sourceProofD_missing"
      }
      return "sourceProofC_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
