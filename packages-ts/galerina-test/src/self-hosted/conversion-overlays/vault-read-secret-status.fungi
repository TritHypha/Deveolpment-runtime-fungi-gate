@version 1
/// Requires encoded coordinates, successful request, KV payload and serialization.
pure flow vaultReadSecretStatusCore(pathEncoded: Bool, mountEncoded: Bool, requestSucceeded: Bool, dataPresent: Bool, serialized: Bool) -> String {
  if pathEncoded {
    let mountReady: Bool = mountEncoded
    if mountReady {
      if requestSucceeded {
        if dataPresent {
          let outputReady: Bool = serialized
          if outputReady { return "secret_read" }
          return "serialization_failed"
        }
        return "data_missing"
      }
      return "vault_request_failed"
    }
    return "mount_invalid"
  }
  return "path_invalid"
}
