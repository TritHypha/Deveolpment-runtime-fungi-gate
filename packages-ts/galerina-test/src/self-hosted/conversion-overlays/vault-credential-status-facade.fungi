@version 1
pure flow vaultCredentialStatusFacadeCore(idCaptured: Bool, managerBound: Bool, redactedReturned: Bool) -> String {
  let idReady: Bool = idCaptured
  let managerReady: Bool = managerBound
  if idReady { if managerReady { let safeView: Bool = redactedReturned if safeView { return "credential_status" } return "secret_exposed" } return "manager_missing" } return "id_missing"
}
