@version 1
pure flow vaultCliRunStatusCore(commandPresent: Bool, branchKnown: Bool, operationCompleted: Bool, cleanupCompleted: Bool) -> String {
  let evidence01: Bool = commandPresent
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  let evidence09: Bool = evidence08
  let evidence10: Bool = evidence09
  if evidence10 { let branchReady: Bool = branchKnown if branchReady { let operationReady: Bool = operationCompleted if operationReady { if cleanupCompleted { return "cli_run_complete" } return "cleanup_failed" } return "operation_failed" } return "command_unknown" } return "command_missing"
}
