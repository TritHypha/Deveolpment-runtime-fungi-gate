@version 1
/// Refuses missing secrets and wipes bytes before deleting metadata.
pure flow sporeRemoveSecretStatusCore(secretPresent: Bool, valueWiped: Bool, metadataDeleted: Bool) -> String {
  let present: Bool = secretPresent
  let cleanupRequired: Bool = present
  if present {
    let wipeComplete: Bool = valueWiped
    if wipeComplete {
      let deleteComplete: Bool = metadataDeleted
      if cleanupRequired {
        if deleteComplete { return "secret_removed" }
        return "metadata_retained"
      }
      return "cleanup_not_required"
    }
    return "wipe_failed"
  }
  return "secret_missing"
}
