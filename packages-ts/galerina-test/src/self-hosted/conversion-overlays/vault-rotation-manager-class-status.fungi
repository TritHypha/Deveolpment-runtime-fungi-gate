@version 1
pure flow vaultRotationManagerClassStatusCore(classReady: Bool, handlesOwned: Bool, leasesOwned: Bool) -> String {
  let evidence01: Bool = classReady
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  if evidence08 { let handlesReady: Bool = handlesOwned if handlesReady { let leasesReady: Bool = leasesOwned if leasesReady { return "rotation_manager_class" } return "leases_unowned" } return "handles_unowned" } return "class_missing"
}
