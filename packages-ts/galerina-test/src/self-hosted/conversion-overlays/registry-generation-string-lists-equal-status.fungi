// Source-bound decision overlay wave 16 item 29: registry-generation-string-lists-equal-status.fungi.
pure flow registryGenerationStringListsEqualStatusCore(leftCaptured: Bool, rightCaptured: Bool, lengthsEqual: Bool, itemsEqual: Bool) -> String {
  let sourceProofA: Bool = rightCaptured
  let sourceProofB: Bool = itemsEqual
  if sourceProofA {
    if sourceProofB {
      if leftCaptured {
        if rightCaptured {
          if lengthsEqual {
            if itemsEqual {
              return "registry_generation_lists_equal"
            }
            return "itemsEqual_missing"
          }
          return "lengthsEqual_missing"
        }
        return "rightCaptured_missing"
      }
      return "leftCaptured_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
