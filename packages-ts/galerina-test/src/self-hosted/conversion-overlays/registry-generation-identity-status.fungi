@version 1
// Source-bound decision overlay wave 16 item 37: registry-generation-identity-status.fungi.
pure flow registryGenerationIdentityStatusCore(generationCaptured: Bool, canonicalReady: Bool, domainFramed: Bool, digestComputed: Bool, hexEncoded: Bool) -> String {
  let sourceProofA: Bool = canonicalReady
  let sourceProofB: Bool = digestComputed
  if sourceProofA {
    if sourceProofB {
      if generationCaptured {
        if canonicalReady {
          if domainFramed {
            if digestComputed {
              if hexEncoded {
                return "registry_generation_identity_derived"
              }
              return "hexEncoded_missing"
            }
            return "digestComputed_missing"
          }
          return "domainFramed_missing"
        }
        return "canonicalReady_missing"
      }
      return "generationCaptured_missing"
    }
    return "sourceProofB_missing"
  }
  return "sourceProofA_missing"
}
