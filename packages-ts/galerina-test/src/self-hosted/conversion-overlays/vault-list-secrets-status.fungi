@version 1
/// Produces the Vault key list after mount encoding and LIST completion.
pure flow vaultListSecretsStatusCore(mountEncoded: Bool, requestSucceeded: Bool, keysPresent: Bool) -> String {
  let mountReady: Bool = mountEncoded
  let requestReady: Bool = requestSucceeded
  let listReady: Bool = keysPresent
  let responseReady: Bool = requestReady
  let outputReady: Bool = listReady
  if mountReady {
    if responseReady {
      if outputReady {
        if listReady { return "vault_keys" }
        return "keys_changed"
      }
      return "empty_key_list"
    }
    return "list_request_failed"
  }
  return "list_mount_invalid"
}
