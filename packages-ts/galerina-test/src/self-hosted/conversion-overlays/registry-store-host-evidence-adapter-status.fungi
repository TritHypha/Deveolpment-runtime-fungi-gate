  let sourceProofA: Bool = capabilityMinted
  let sourceProofB: Bool = optionsCaptured
  if sourceProofA {
    if sourceProofB {
      if optionsCaptured {
        if identityValid {
          if digestValid {
            if callbackCaptured {
              if capabilityMinted {
                return "registry_store_adapter_issued"
              }
