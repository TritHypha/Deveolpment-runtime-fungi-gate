@version 1
/// AES-GCM wrap choreography and mandatory derived-key wipe.
pure flow recipientSecretWrapStatusCore(secretPresent: Bool, saltReady: Bool, ivReady: Bool, cipherFinal: Bool, tagReady: Bool, keyWiped: Bool) -> String {
  if secretPresent {
    if saltReady {
      if ivReady {
        if cipherFinal {
          if tagReady {
            if keyWiped { return "wrapped_wiped" }
            return "wipe_missing"
          }
          return "tag_missing"
        }
        return "cipher_failed"
      }
      return "iv_missing"
    }
    return "salt_missing"
  }
  return "secret_missing"
}
