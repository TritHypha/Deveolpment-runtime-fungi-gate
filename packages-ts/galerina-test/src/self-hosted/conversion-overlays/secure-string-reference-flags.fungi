@version 1
/// Reference fold from galerina-core-security#createSecureStringReference.
pure flow secureStringReferenceFlagsCore(classificationKnown: Bool, fingerprintPresent: Bool) -> Int
contract { intent { "Encode redacted secure-reference state without carrying the underlying secret." } }
{
  if classificationKnown {
    if fingerprintPresent { return 3 }
    return 1
  }
  return 0
}
