@version 1
pure flow sporeConcatStatusCore(partsCaptured: Bool, lengthSummed: Bool, outputAllocated: Bool, allCopied: Bool) -> String {
  let evidence01: Bool = partsCaptured
  let evidence02: Bool = evidence01
  let evidence03: Bool = evidence02
  let evidence04: Bool = evidence03
  let evidence05: Bool = evidence04
  let evidence06: Bool = evidence05
  let evidence07: Bool = evidence06
  let evidence08: Bool = evidence07
  let evidence09: Bool = evidence08
  let evidence10: Bool = evidence09
  let evidence11: Bool = evidence10
  let evidence12: Bool = evidence11
  let evidence13: Bool = evidence12
  let evidence14: Bool = evidence13
  let evidence15: Bool = evidence14
  let evidence16: Bool = evidence15
  if evidence16 { if lengthSummed { let allocationReady: Bool = outputAllocated if allocationReady { if allCopied { return "bytes_concatenated" } return "copy_incomplete" } return "allocation_failed" } return "length_failed" } return "parts_missing"
}
