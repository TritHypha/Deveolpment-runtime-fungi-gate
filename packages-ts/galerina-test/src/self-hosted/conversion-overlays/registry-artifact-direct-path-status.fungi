// Source-bound decision overlay wave 18 item 33: registry-artifact-direct-path-status.fungi.
pure flow registryArtifactDirectPathStatusCore(rootCaptured: Bool, descriptorCaptured: Bool, segmentsBound: Bool, metadataValid: Bool, pathReturned: Bool) -> String {
  let sourceProofA: Bool = metadataValid
  let sourceProofB: Bool = descriptorCaptured
  if sourceProofA {
    if sourceProofB {
      if metadataValid {
        if rootCaptured {
          if descriptorCaptured {
            if segmentsBound {
              if pathReturned {
                return "registry_artifact_path_direct"
              }
