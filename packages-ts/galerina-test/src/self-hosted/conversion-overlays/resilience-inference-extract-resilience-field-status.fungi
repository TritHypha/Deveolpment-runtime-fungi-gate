@version 1
// Source-bound decision overlay wave 50 item 2: resilience-inference.ts#extractResilienceField.
pure flow resilienceInferenceExtractResilienceFieldStatusCore(sourceReady: Bool, shapeReady: Bool, stateReady: Bool, policyReady: Bool, routeReady: Bool, proofReady: Bool, sealReady: Bool) -> String {
  if sourceReady {
    if shapeReady {
      if stateReady {
        if policyReady {
          if routeReady {
            if sealReady {
              if proofReady { return "resilience_inference_extract_resilience_field_built" }
              return "wave50_proof_missing"
            }
            return "wave50_seal_missing"
          }
          return "wave50_route_missing"
        }
        return "wave50_policy_missing"
      }
      return "wave50_state_missing"
    }
    return "wave50_shape_missing"
  }
  return "wave50_source_missing"
}
