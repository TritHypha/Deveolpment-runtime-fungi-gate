@version 1
pure flow vaultSecretUseStatusCore(idCaptured: Bool, callbackCaptured: Bool, delegated: Bool) -> String {
  let idReady: Bool = idCaptured
  if idReady { let callbackReady: Bool = callbackCaptured if callbackReady { if delegated { return "secret_use_delegated" } return "delegation_failed" } return "callback_missing" } return "id_missing"
}
