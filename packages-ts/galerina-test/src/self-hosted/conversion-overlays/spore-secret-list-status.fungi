@version 1
/// Releases only names and copied metadata after read composition succeeds.
pure flow sporeSecretListStatusCore(compositionReady: Bool, namesCaptured: Bool, metadataCopied: Bool) -> String {
  let composition: Bool = compositionReady
  if composition {
    if namesCaptured {
      let copied: Bool = metadataCopied
      if copied { return "secret_list" }
      return "metadata_alias_refused"
    }
    return "names_missing"
  }
  return "list_refused"
}
