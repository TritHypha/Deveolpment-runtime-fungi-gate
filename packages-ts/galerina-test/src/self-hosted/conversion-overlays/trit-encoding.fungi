@version 1
/// Closed valid-domain core of tpl-simulator.ts#encodeTrit; invalid JS numbers remain a typed border refusal.
pure flow encodeTritCore(value: Int) -> Int
contract { intent { "Encode exactly the three admitted arithmetic trits." } }
{
  if value == -1 { return 0 }
  if value == 0 { return 1 }
  if value == 1 { return 2 }
  return 3
}
