@version 1
// EXPECT: ACCEPT
// AREA: concurrency
// PURPOSE: structured await — parallel calls with timeout policy
record EnrichedOrder {
  customer: Customer
  stock: StockStatus
  risk: RiskScore
}

record Customer {
  id: CustomerId
}

record StockStatus {
  available: Bool
}

record RiskScore {
  score: Float
}

// The admitted host scheduler may execute these independent calls in parallel;
// `async`/`await` are reserved and are not part of the v1 language grammar.
secure flow enrichOrder(input: CreateOrderRequest) -> Result<EnrichedOrder, ApiError>
contract {
  intent { "Enrich an order through three admitted outbound services." }
  effects { network.outbound }
}
{
  let customer = CustomersApi.get(input.customerId)
  let stock = StockApi.check(input.items)
  let risk = RiskApi.score(input)

  return Ok(EnrichedOrder {
    customer: customer
    stock: stock
    risk: risk
  })
}
