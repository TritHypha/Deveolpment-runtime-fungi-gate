@version 1
// Browser targets and capabilities are admitted manifest data. Keeping them
// out of executable syntax prevents an unaudited source declaration from
// minting DOM, network, storage, filesystem, or secret authority.

record ContactFormData {
  name: String
  email: String
  message: String
}

secure flow main() -> Result<Void, Error>
contract { intent { "Initialize a browser form only after host capability admission." } }
{
  return Ok()
}
