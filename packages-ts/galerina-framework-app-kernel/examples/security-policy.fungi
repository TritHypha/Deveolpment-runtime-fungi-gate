@version 1
// Deny-by-default policy decisions. Host firewall and filesystem enforcement
// consume these decisions only after the surrounding manifest is admitted.

pure flow allowApiMethod(method: String) -> Bool {
  match method {
    "GET" => return true
    "POST" => return true
    _ => return false
  }
}

pure flow allowInboundPort(port: Int) -> Bool {
  match port {
    80 => return true
    443 => return true
    _ => return false
  }
}

pure flow allowFileAccess(path: String) -> Bool {
  return false
}

pure flow allowShell(command: String) -> Bool {
  return false
}
