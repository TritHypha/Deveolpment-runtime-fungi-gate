@version 1
/// @file: slide-v2a-semantic-digest.fungi
/// @purpose: Bind independently decoded and validated V2-A bytes to the v2 semantic domain.
/// @status: Digest evidence only; never admission authority.

record SLIDEV2ASemanticBinding {
  decision: SLIDEV2ADecision
  digestSuiteId: String
  domainId: String
  bodyDigest: String
  semanticDigest: String
}

// Release no digest for refused or unavailable V2 semantics.
pure flow emptySLIDEV2ASemanticBinding(
  decision: SLIDEV2ADecision,
) -> SLIDEV2ASemanticBinding
contract { intent { "Release no digest for refused or unavailable V2 semantics." } }
{
  return {
    decision: decision
    digestSuiteId: "slide.digest.sha256.v1"
    domainId: "slide.gir.semantic.v2"
    bodyDigest: ""
    semanticDigest: ""
  }
}

// Hash only the exact independently decoded and semantically admitted V2-A body.
pure flow bindSLIDEV2ASemanticDigest(
  body: Bytes,
) -> SLIDEV2ASemanticBinding
contract { intent { "Hash only the exact independently decoded and semantically admitted V2-A body." } }
{
  let imported = decodeSLIDEV2AProgram(body)
  check(imported.decision.verdict) {
    deny: { return emptySLIDEV2ASemanticBinding(imported.decision) }
    ambig: { return emptySLIDEV2ASemanticBinding(imported.decision) }
    if: {}
  }
  let domainPrefix = Bytes.fromHex(
    "736c6964652e6769722e73656d616e7469632e763200",
  )
  let bodyDigest = body.sha256Hex()
  let semanticDigest = domainPrefix.append(body).sha256Hex()
  if bodyDigest.length() != 64 or semanticDigest.length() != 64 {
    return emptySLIDEV2ASemanticBinding(
      slideV2ARefusal(
        "SLIDE-V2A-DIGEST-001", "registered SHA-256 primitive unavailable",
      ),
    )
  }
  return {
    decision: imported.decision
    digestSuiteId: "slide.digest.sha256.v1"
    domainId: "slide.gir.semantic.v2"
    bodyDigest: bodyDigest
    semanticDigest: semanticDigest
  }
}
