@version 1
/// @file: slide-r1-program-importer.fungi
/// @purpose: Reconstruct an independently owned typed SLIDE R1 program from canonical bytes.
/// @status: Closed-registry R1 decoder and semantic validator; no encoder or AST dependency.
///
/// This module is combined with slide-r1-cbor-importer.fungi for its bounded
/// canonical-CBOR primitives. It does not call the exact-vector validator or
/// the fixed structural admission flow. Every numeric program field is read
/// from the candidate bytes into records owned by this module.

record SLIDER1DecodedInstruction {
  resultId: Int
  opcodeId: Int
  typeId: Int
  operands: Array<Int>
  immediate: Int
}

record SLIDER1DecodedTerminator {
  terminatorId: Int
  operands: Array<Int>
}

record SLIDER1DecodedBlock {
  blockId: Int
  instructions: Array<SLIDER1DecodedInstruction>
  terminator: SLIDER1DecodedTerminator
}

record SLIDER1DecodedFailure {
  failureId: Int
  classId: Int
  visibilityId: Int
  retryId: Int
  actionId: Int
}

record SLIDER1DecodedK3 {
  obligationId: Int
  functionId: Int
  checkBlockId: Int
  allowBlockId: Int
  denyBlockId: Int
  indeterminateBlockId: Int
}

record SLIDER1DecodedProgram {
  formatMajor: Int
  formatMinor: Int
  semanticProfileId: String
  digestSuiteId: String
  memoryProfileId: String
  fixtureName: String
  stableSymbolId: String
  qualifierId: Int
  parameterTypeIds: Array<Int>
  resultTypeId: Int
  entryBlockId: Int
  blocks: Array<SLIDER1DecodedBlock>
  failures: Array<SLIDER1DecodedFailure>
  k3Obligations: Array<SLIDER1DecodedK3>
}

record SLIDER1UIntDecode {
  cursor: SLIDER1ImportCursor
  value: Int
}

record SLIDER1InstructionDecode {
  cursor: SLIDER1ImportCursor
  value: SLIDER1DecodedInstruction
}

record SLIDER1TerminatorDecode {
  cursor: SLIDER1ImportCursor
  value: SLIDER1DecodedTerminator
}

record SLIDER1BlockDecode {
  cursor: SLIDER1ImportCursor
  value: SLIDER1DecodedBlock
}

record SLIDER1FailureDecode {
  cursor: SLIDER1ImportCursor
  value: SLIDER1DecodedFailure
}

record SLIDER1K3Decode {
  cursor: SLIDER1ImportCursor
  value: SLIDER1DecodedK3
}

record SLIDER1ProgramImport {
  decision: SLIDER1ImportDecision
  program: SLIDER1DecodedProgram
}

// Return an inert instruction used only behind a refusal cursor.
pure flow emptySLIDER1DecodedInstruction() -> SLIDER1DecodedInstruction
contract { intent { "Return an inert instruction used only behind a refusal cursor." } }
{
  return { resultId: -1 opcodeId: -1 typeId: -1 operands: [] immediate: -1 }
}

// Return an inert terminator used only behind a refusal cursor.
pure flow emptySLIDER1DecodedTerminator() -> SLIDER1DecodedTerminator
contract { intent { "Return an inert terminator used only behind a refusal cursor." } }
{
  return { terminatorId: -1 operands: [] }
}

// Return an inert block used only behind a refusal cursor.
pure flow emptySLIDER1DecodedBlock() -> SLIDER1DecodedBlock
contract { intent { "Return an inert block used only behind a refusal cursor." } }
{
  return {
    blockId: -1
    instructions: []
    terminator: emptySLIDER1DecodedTerminator()
  }
}

// Return an inert failure used only behind a refusal cursor.
pure flow emptySLIDER1DecodedFailure() -> SLIDER1DecodedFailure
contract { intent { "Return an inert failure used only behind a refusal cursor." } }
{
  return {
    failureId: -1 classId: -1 visibilityId: -1 retryId: -1 actionId: -1
  }
}

// Return an inert K3 obligation used only behind a refusal cursor.
pure flow emptySLIDER1DecodedK3() -> SLIDER1DecodedK3
contract { intent { "Return an inert K3 obligation used only behind a refusal cursor." } }
{
  return {
    obligationId: -1 functionId: -1 checkBlockId: -1
    allowBlockId: -1 denyBlockId: -1 indeterminateBlockId: -1
  }
}

// Return a no-authority program value for refused imports.
pure flow emptySLIDER1DecodedProgram() -> SLIDER1DecodedProgram
contract { intent { "Return a no-authority program value for refused imports." } }
{
  return {
    formatMajor: -1
    formatMinor: -1
    semanticProfileId: ""
    digestSuiteId: ""
    memoryProfileId: ""
    fixtureName: ""
    stableSymbolId: ""
    qualifierId: -1
    parameterTypeIds: []
    resultTypeId: -1
    entryBlockId: -1
    blocks: []
    failures: []
    k3Obligations: []
  }
}

// Create one typed program-import decision.
pure flow slideR1ProgramDecision(
  verdict: Verdict,
  status: String,
  failureId: String,
  reasonText: String,
  consumed: Int,
) -> SLIDER1ImportDecision
contract { intent { "Create one typed program-import decision." } }
{
  return {
    verdict: verdict status: status failureId: failureId
    reason: reasonText consumed: consumed
  }
}

// Decode one canonical unsigned field while retaining its value.
pure flow slideR1ReadUInt(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
  failureId: String,
  reasonText: String,
) -> SLIDER1UIntDecode
contract { intent { "Decode one canonical unsigned field while retaining its value." } }
{
  if cursor.ok == false { return { cursor: cursor value: -1 } }
  let read = slideR1ReadCanonicalHead(bytes, cursor.offset, 0)
  if read.ok == false {
    return {
      cursor: slideR1ImportFailure(cursor.offset, read.failureId, read.reason)
      value: -1
    }
  }
  if read.value < 0 {
    return {
      cursor: slideR1ImportFailure(cursor.offset, failureId, reasonText)
      value: -1
    }
  }
  return {
    cursor: { ok: true offset: read.nextOffset failureId: "NONE" reason: "" }
    value: read.value
  }
}

// Decode one definite canonical array count under a hard local ceiling.
pure flow slideR1ReadArrayCount(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
  ceiling: Int,
  failureId: String,
  reasonText: String,
) -> SLIDER1UIntDecode
contract { intent { "Decode one definite canonical array count under a hard local ceiling." } }
{
  if cursor.ok == false { return { cursor: cursor value: -1 } }
  let read = slideR1ReadCanonicalHead(bytes, cursor.offset, 4)
  if read.ok == false {
    return {
      cursor: slideR1ImportFailure(cursor.offset, read.failureId, read.reason)
      value: -1
    }
  }
  if read.value > ceiling {
    return {
      cursor: slideR1ImportFailure(cursor.offset, failureId, reasonText)
      value: -1
    }
  }
  return {
    cursor: { ok: true offset: read.nextOffset failureId: "NONE" reason: "" }
    value: read.value
  }
}

// Decode a bounded unsigned array into the operand field of an inert instruction carrier.
pure flow slideR1DecodeIntArray(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
  ceiling: Int,
  failureId: String,
) -> SLIDER1InstructionDecode
contract {
  intent { "Decode a bounded unsigned array into the operand field of an inert instruction carrier." }
}
{
  let countRead = slideR1ReadArrayCount(
    bytes, cursor, ceiling, failureId, "integer-array count exceeds R1 ceiling",
  )
  mut c: SLIDER1ImportCursor = countRead.cursor
  mut values: Array<Int> = Array.empty()
  mut i: Int = 0
  while i < countRead.value and c.ok {
    let item = slideR1ReadUInt(bytes, c, failureId, "invalid unsigned array item")
    c = item.cursor
    if c.ok { values = values.append(item.value) }
    i = i + 1
  }
  return {
    cursor: c
    value: {
      resultId: -1 opcodeId: -1 typeId: -1
      operands: values immediate: -1
    }
  }
}

// Decode one typed R1 instruction without assigning semantics.
pure flow slideR1DecodeInstruction(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
) -> SLIDER1InstructionDecode
contract { intent { "Decode one typed R1 instruction without assigning semantics." } }
{
  let shape = slideR1ReadArrayCount(
    bytes, cursor, 5, "SLIDE-R1-DECODE-020", "instruction record is oversized",
  )
  mut c: SLIDER1ImportCursor = shape.cursor
  if shape.value != 5 and c.ok {
    c = slideR1ImportFailure(cursor.offset, "SLIDE-R1-DECODE-020", "instruction record must contain five fields")
  }
  let resultRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-021", "invalid result identity")
  c = resultRead.cursor
  let opcodeRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-022", "invalid opcode identity")
  c = opcodeRead.cursor
  let typeRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-023", "invalid instruction type identity")
  c = typeRead.cursor
  let operandRead = slideR1DecodeIntArray(bytes, c, 8, "SLIDE-R1-DECODE-024")
  c = operandRead.cursor
  let immediateRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-026", "invalid instruction immediate")
  c = immediateRead.cursor
  return {
    cursor: c
    value: {
      resultId: resultRead.value
      opcodeId: opcodeRead.value
      typeId: typeRead.value
      operands: operandRead.value.operands
      immediate: immediateRead.value
    }
  }
}

// Decode one total R1 terminator without assigning control semantics.
pure flow slideR1DecodeTerminator(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
) -> SLIDER1TerminatorDecode
contract { intent { "Decode one total R1 terminator without assigning control semantics." } }
{
  let shape = slideR1ReadArrayCount(
    bytes, cursor, 2, "SLIDE-R1-DECODE-030", "terminator record is oversized",
  )
  mut c: SLIDER1ImportCursor = shape.cursor
  if shape.value != 2 and c.ok {
    c = slideR1ImportFailure(cursor.offset, "SLIDE-R1-DECODE-030", "terminator record must contain two fields")
  }
  let idRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-031", "invalid terminator identity")
  c = idRead.cursor
  let operandRead = slideR1DecodeIntArray(bytes, c, 8, "SLIDE-R1-DECODE-032")
  c = operandRead.cursor
  return {
    cursor: c
    value: { terminatorId: idRead.value operands: operandRead.value.operands }
  }
}

// Decode one bounded R1 block into independently owned records.
pure flow slideR1DecodeBlock(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
) -> SLIDER1BlockDecode
contract { intent { "Decode one bounded R1 block into independently owned records." } }
{
  let shape = slideR1ReadArrayCount(
    bytes, cursor, 3, "SLIDE-R1-DECODE-036", "block record is oversized",
  )
  mut c: SLIDER1ImportCursor = shape.cursor
  if shape.value != 3 and c.ok {
    c = slideR1ImportFailure(cursor.offset, "SLIDE-R1-DECODE-036", "block record must contain three fields")
  }
  let idRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-037", "invalid block identity")
  c = idRead.cursor
  let countRead = slideR1ReadArrayCount(
    bytes, c, 32, "SLIDE-R1-DECODE-038", "instruction count exceeds R1 ceiling",
  )
  c = countRead.cursor
  mut instructions: Array<SLIDER1DecodedInstruction> = Array.empty()
  mut i: Int = 0
  while i < countRead.value and c.ok {
    let decoded = slideR1DecodeInstruction(bytes, c)
    c = decoded.cursor
    if c.ok { instructions = instructions.append(decoded.value) }
    i = i + 1
  }
  let terminatorRead = slideR1DecodeTerminator(bytes, c)
  c = terminatorRead.cursor
  return {
    cursor: c
    value: {
      blockId: idRead.value
      instructions: instructions
      terminator: terminatorRead.value
    }
  }
}

// Decode one declared R1 failure record.
pure flow slideR1DecodeFailure(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
) -> SLIDER1FailureDecode
contract { intent { "Decode one declared R1 failure record." } }
{
  let shape = slideR1ReadArrayCount(
    bytes, cursor, 5, "SLIDE-R1-DECODE-040", "failure record is oversized",
  )
  mut c: SLIDER1ImportCursor = shape.cursor
  if shape.value != 5 and c.ok {
    c = slideR1ImportFailure(cursor.offset, "SLIDE-R1-DECODE-040", "failure record must contain five fields")
  }
  let idRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-041", "invalid failure identity")
  c = idRead.cursor
  let classRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-041", "invalid failure class")
  c = classRead.cursor
  let visibilityRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-041", "invalid failure visibility")
  c = visibilityRead.cursor
  let retryRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-041", "invalid failure retry policy")
  c = retryRead.cursor
  let actionRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-041", "invalid failure action")
  c = actionRead.cursor
  return {
    cursor: c
    value: {
      failureId: idRead.value
      classId: classRead.value
      visibilityId: visibilityRead.value
      retryId: retryRead.value
      actionId: actionRead.value
    }
  }
}

// Decode one K3 obligation without trusting successor meaning.
pure flow slideR1DecodeK3(
  bytes: Bytes,
  cursor: SLIDER1ImportCursor,
) -> SLIDER1K3Decode
contract { intent { "Decode one K3 obligation without trusting successor meaning." } }
{
  let shape = slideR1ReadArrayCount(
    bytes, cursor, 6, "SLIDE-R1-DECODE-042", "K3 obligation is oversized",
  )
  mut c: SLIDER1ImportCursor = shape.cursor
  if shape.value != 6 and c.ok {
    c = slideR1ImportFailure(cursor.offset, "SLIDE-R1-DECODE-042", "K3 obligation must contain six fields")
  }
  let obligationRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid obligation identity")
  c = obligationRead.cursor
  let functionRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid function identity")
  c = functionRead.cursor
  let checkRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid check block")
  c = checkRead.cursor
  let allowRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid allow block")
  c = allowRead.cursor
  let denyRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid deny block")
  c = denyRead.cursor
  let unresolvedRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-043", "invalid indeterminate block")
  c = unresolvedRead.cursor
  return {
    cursor: c
    value: {
      obligationId: obligationRead.value
      functionId: functionRead.value
      checkBlockId: checkRead.value
      allowBlockId: allowRead.value
      denyBlockId: denyRead.value
      indeterminateBlockId: unresolvedRead.value
    }
  }
}

// Decode canonical SLIDE R1 bytes into an independent typed graph without semantic fix-up.
pure flow decodeSLIDER1Program(bytes: Bytes) -> SLIDER1ProgramImport
contract {
  intent { "Decode canonical SLIDE R1 bytes into an independent typed graph without semantic fix-up." }
}
{
  if bytes.length() > 4096 {
    return {
      decision: slideR1ProgramDecision(
        Verdict.Deny, "REFUSED", "SLIDE-R1-DECODE-005",
        "R1 body exceeds the hard byte ceiling", 0,
      )
      program: emptySLIDER1DecodedProgram()
    }
  }

  mut c: SLIDER1ImportCursor = { ok: true offset: 0 failureId: "NONE" reason: "" }
  let rootRead = slideR1ReadCanonicalHead(bytes, c.offset, 5)
  if rootRead.ok == false {
    return {
      decision: slideR1ProgramDecision(
        Verdict.Deny, "REFUSED", rootRead.failureId, rootRead.reason, c.offset,
      )
      program: emptySLIDER1DecodedProgram()
    }
  }
  if rootRead.value != 14 {
    return {
      decision: slideR1ProgramDecision(
        Verdict.Deny, "REFUSED", "SLIDE-R1-DECODE-010",
        "root map must contain exactly fourteen entries", c.offset,
      )
      program: emptySLIDER1DecodedProgram()
    }
  }
  c = { ok: true offset: rootRead.nextOffset failureId: "NONE" reason: "" }

  c = slideR1ExpectUInt(bytes, c, 0, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let majorRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-012", "invalid format major")
  c = majorRead.cursor
  c = slideR1ExpectUInt(bytes, c, 1, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let minorRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-012", "invalid format minor")
  c = minorRead.cursor

  c = slideR1ExpectUInt(bytes, c, 2, "SLIDE-R1-DECODE-011", "root key order mismatch")
  c = slideR1ExpectText(
    bytes, c, "slide.semantic.galerina-gir.v1",
    "SLIDE-R1-DECODE-013", "semantic profile mismatch",
  )
  c = slideR1ExpectUInt(bytes, c, 3, "SLIDE-R1-DECODE-011", "root key order mismatch")
  c = slideR1ExpectText(
    bytes, c, "slide.digest.sha256.v1",
    "SLIDE-R1-DECODE-014", "digest suite mismatch",
  )
  c = slideR1ExpectUInt(bytes, c, 4, "SLIDE-R1-DECODE-011", "root key order mismatch")
  c = slideR1ExpectText(
    bytes, c, "slide.memory.safe-value.v1",
    "SLIDE-R1-DECODE-015", "memory profile mismatch",
  )
  c = slideR1ExpectUInt(bytes, c, 5, "SLIDE-R1-DECODE-011", "root key order mismatch")
  c = slideR1ExpectText(
    bytes, c, "slide_k3_checked_add_v1",
    "SLIDE-R1-DECODE-016", "fixture identity mismatch",
  )
  c = slideR1ExpectUInt(bytes, c, 6, "SLIDE-R1-DECODE-011", "root key order mismatch")
  c = slideR1ExpectText(
    bytes, c, "slide.fixture.k3-checked-add.v1",
    "SLIDE-R1-DECODE-017", "stable symbol mismatch",
  )

  c = slideR1ExpectUInt(bytes, c, 7, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let qualifierRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-018", "invalid qualifier identity")
  c = qualifierRead.cursor
  c = slideR1ExpectUInt(bytes, c, 8, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let parameterRead = slideR1DecodeIntArray(bytes, c, 8, "SLIDE-R1-DECODE-019")
  c = parameterRead.cursor
  c = slideR1ExpectUInt(bytes, c, 9, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let resultRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-023", "invalid result type identity")
  c = resultRead.cursor
  c = slideR1ExpectUInt(bytes, c, 10, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let entryRead = slideR1ReadUInt(bytes, c, "SLIDE-R1-DECODE-035", "invalid entry block identity")
  c = entryRead.cursor

  c = slideR1ExpectUInt(bytes, c, 11, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let blockCountRead = slideR1ReadArrayCount(
    bytes, c, 16, "SLIDE-R1-DECODE-036", "block count exceeds R1 ceiling",
  )
  c = blockCountRead.cursor
  mut blocks: Array<SLIDER1DecodedBlock> = Array.empty()
  mut blockIndex: Int = 0
  while blockIndex < blockCountRead.value and c.ok {
    let decoded = slideR1DecodeBlock(bytes, c)
    c = decoded.cursor
    if c.ok { blocks = blocks.append(decoded.value) }
    blockIndex = blockIndex + 1
  }

  c = slideR1ExpectUInt(bytes, c, 12, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let failureCountRead = slideR1ReadArrayCount(
    bytes, c, 16, "SLIDE-R1-DECODE-040", "failure count exceeds R1 ceiling",
  )
  c = failureCountRead.cursor
  mut failures: Array<SLIDER1DecodedFailure> = Array.empty()
  mut failureIndex: Int = 0
  while failureIndex < failureCountRead.value and c.ok {
    let decoded = slideR1DecodeFailure(bytes, c)
    c = decoded.cursor
    if c.ok { failures = failures.append(decoded.value) }
    failureIndex = failureIndex + 1
  }

  c = slideR1ExpectUInt(bytes, c, 13, "SLIDE-R1-DECODE-011", "root key order mismatch")
  let k3CountRead = slideR1ReadArrayCount(
    bytes, c, 16, "SLIDE-R1-DECODE-042", "K3 obligation count exceeds R1 ceiling",
  )
  c = k3CountRead.cursor
  mut obligations: Array<SLIDER1DecodedK3> = Array.empty()
  mut k3Index: Int = 0
  while k3Index < k3CountRead.value and c.ok {
    let decoded = slideR1DecodeK3(bytes, c)
    c = decoded.cursor
    if c.ok { obligations = obligations.append(decoded.value) }
    k3Index = k3Index + 1
  }

  if c.ok == false {
    return {
      decision: slideR1ProgramDecision(
        Verdict.Deny, "REFUSED", c.failureId, c.reason, c.offset,
      )
      program: emptySLIDER1DecodedProgram()
    }
  }
  if c.offset != bytes.length() {
    return {
      decision: slideR1ProgramDecision(
        Verdict.Deny, "REFUSED", "SLIDE-R1-DECODE-044",
        "trailing bytes after complete R1 body", c.offset,
      )
      program: emptySLIDER1DecodedProgram()
    }
  }

  return {
    decision: slideR1ProgramDecision(
      Verdict.Allow, "DECODED", "NONE",
      "canonical R1 bytes reconstructed into a typed program", c.offset,
    )
    program: {
      formatMajor: majorRead.value
      formatMinor: minorRead.value
      semanticProfileId: "slide.semantic.galerina-gir.v1"
      digestSuiteId: "slide.digest.sha256.v1"
      memoryProfileId: "slide.memory.safe-value.v1"
      fixtureName: "slide_k3_checked_add_v1"
      stableSymbolId: "slide.fixture.k3-checked-add.v1"
      qualifierId: qualifierRead.value
      parameterTypeIds: parameterRead.value.operands
      resultTypeId: resultRead.value
      entryBlockId: entryRead.value
      blocks: blocks
      failures: failures
      k3Obligations: obligations
    }
  }
}

// Read one decoded integer or return a no-authority sentinel.
pure flow slideR1DecodedIntAt(values: Array<Int>, position: Int) -> Int
contract { intent { "Read one decoded integer or return a no-authority sentinel." } }
{
  let item = values.get(position)
  match item {
    Some(value) => { return value }
    None => { return -1 }
    _ => { return -1 }
  }
}

// Read one decoded instruction or return an inert sentinel.
pure flow slideR1DecodedInstructionAt(
  values: Array<SLIDER1DecodedInstruction>,
  position: Int,
) -> SLIDER1DecodedInstruction
contract { intent { "Read one decoded instruction or return an inert sentinel." } }
{
  let item = values.get(position)
  match item {
    Some(value) => { return value }
    None => { return emptySLIDER1DecodedInstruction() }
    _ => { return emptySLIDER1DecodedInstruction() }
  }
}

// Read one decoded block or return an inert sentinel.
pure flow slideR1DecodedBlockAt(
  values: Array<SLIDER1DecodedBlock>,
  position: Int,
) -> SLIDER1DecodedBlock
contract { intent { "Read one decoded block or return an inert sentinel." } }
{
  let item = values.get(position)
  match item {
    Some(value) => { return value }
    None => { return emptySLIDER1DecodedBlock() }
    _ => { return emptySLIDER1DecodedBlock() }
  }
}

// Read one decoded failure or return an inert sentinel.
pure flow slideR1DecodedFailureAt(
  values: Array<SLIDER1DecodedFailure>,
  position: Int,
) -> SLIDER1DecodedFailure
contract { intent { "Read one decoded failure or return an inert sentinel." } }
{
  let item = values.get(position)
  match item {
    Some(value) => { return value }
    None => { return emptySLIDER1DecodedFailure() }
    _ => { return emptySLIDER1DecodedFailure() }
  }
}

// Read one decoded K3 obligation or return an inert sentinel.
pure flow slideR1DecodedK3At(
  values: Array<SLIDER1DecodedK3>,
  position: Int,
) -> SLIDER1DecodedK3
contract { intent { "Read one decoded K3 obligation or return an inert sentinel." } }
{
  let item = values.get(position)
  match item {
    Some(value) => { return value }
    None => { return emptySLIDER1DecodedK3() }
    _ => { return emptySLIDER1DecodedK3() }
  }
}

// Return one terminal semantic-program refusal.
pure flow slideR1ProgramRefusal(
  failureId: String,
  reasonText: String,
) -> SLIDER1ImportDecision
contract { intent { "Return one terminal semantic-program refusal." } }
{
  return slideR1ProgramDecision(
    Verdict.Deny, "REFUSED", failureId, reasonText, 0,
  )
}

// Resolve one globally unique SSA value type without ambient registries.
pure flow slideR1ProgramTypeOfValue(
  program: SLIDER1DecodedProgram,
  resultId: Int,
) -> Int
contract { intent { "Resolve one globally unique SSA value type without ambient registries." } }
{
  mut foundType: Int = -1
  mut blockIndex: Int = 0
  while blockIndex < program.blocks.count() {
    let block = slideR1DecodedBlockAt(program.blocks, blockIndex)
    mut instructionIndex: Int = 0
    while instructionIndex < block.instructions.count() {
      let instruction = slideR1DecodedInstructionAt(
        block.instructions, instructionIndex,
      )
      if instruction.resultId == resultId { foundType = instruction.typeId }
      instructionIndex = instructionIndex + 1
    }
    blockIndex = blockIndex + 1
  }
  return foundType
}

// Return the first dense SSA result identity assigned to a block.
pure flow slideR1ProgramBlockFirstResult(
  program: SLIDER1DecodedProgram,
  blockIndex: Int,
) -> Int
contract { intent { "Return the first dense SSA result identity assigned to a block." } }
{
  mut first: Int = 0
  mut i: Int = 0
  while i < blockIndex {
    first = first + slideR1DecodedBlockAt(program.blocks, i).instructions.count()
    i = i + 1
  }
  return first
}

// Require an operand to be entry-dominating or earlier in the same successor block.
pure flow slideR1ProgramOperandVisible(
  program: SLIDER1DecodedProgram,
  blockIndex: Int,
  useBoundary: Int,
  operandId: Int,
) -> Bool
contract {
  intent { "Require an operand to be entry-dominating or earlier in the same successor block." }
}
{
  let entry = slideR1DecodedBlockAt(program.blocks, program.entryBlockId)
  let entryResultCount: Int = entry.instructions.count()
  let blockFirst: Int = slideR1ProgramBlockFirstResult(program, blockIndex)
  if blockIndex == program.entryBlockId {
    return operandId >= blockFirst and operandId < useBoundary
  }
  let fromEntry: Bool = operandId >= 0 and operandId < entryResultCount
  let fromLocal: Bool = operandId >= blockFirst and operandId < useBoundary
  return fromEntry or fromLocal
}

// Check a failure reference against only the decoded failure table.
pure flow slideR1ProgramHasFailure(
  program: SLIDER1DecodedProgram,
  failureId: Int,
) -> Bool
contract { intent { "Check a failure reference against only the decoded failure table." } }
{
  mut found: Bool = false
  mut i: Int = 0
  while i < program.failures.count() {
    if slideR1DecodedFailureAt(program.failures, i).failureId == failureId {
      found = true
    }
    i = i + 1
  }
  return found
}

// Validate one decoded instruction against the frozen registry, SSA visibility, and exact types.
pure flow slideR1ValidateInstruction(
  program: SLIDER1DecodedProgram,
  blockIndex: Int,
  instruction: SLIDER1DecodedInstruction,
) -> SLIDER1ImportDecision
contract {
  intent { "Validate one decoded instruction against the frozen registry, SSA visibility, and exact types." }
}
{
  mut operandIndex: Int = 0
  while operandIndex < instruction.operands.count() {
    let operandId: Int = slideR1DecodedIntAt(instruction.operands, operandIndex)
    if slideR1ProgramOperandVisible(
      program, blockIndex, instruction.resultId, operandId,
    ) == false {
      return slideR1ProgramRefusal(
        "SLIDE-R1-PROGRAM-006",
        "instruction operand is undefined, forward, or does not dominate its use",
      )
    }
    operandIndex = operandIndex + 1
  }

  match instruction.opcodeId {
    1 => {
      if blockIndex != program.entryBlockId {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "parameter instruction is outside the entry block",
        )
      }
      if instruction.operands.count() != 0 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "parameter instruction has operands",
        )
      }
      if instruction.immediate < 0 or instruction.immediate >= program.parameterTypeIds.count() {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "parameter index is outside the function signature",
        )
      }
      if instruction.typeId != slideR1DecodedIntAt(
        program.parameterTypeIds, instruction.immediate,
      ) {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-007", "parameter result type does not match its signature",
        )
      }
    }
    2 => {
      if instruction.typeId != 1 or instruction.operands.count() != 2 or instruction.immediate != 0 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "checked Int32 add shape does not match the registry",
        )
      }
      if slideR1ProgramTypeOfValue(
        program, slideR1DecodedIntAt(instruction.operands, 0),
      ) != 1 or slideR1ProgramTypeOfValue(
        program, slideR1DecodedIntAt(instruction.operands, 1),
      ) != 1 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-007", "checked Int32 add operand type mismatch",
        )
      }
    }
    3 => {
      if instruction.typeId != 3 or instruction.operands.count() != 1 or instruction.immediate != 0 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "result success shape does not match the registry",
        )
      }
      if slideR1ProgramTypeOfValue(
        program, slideR1DecodedIntAt(instruction.operands, 0),
      ) != 1 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-007", "result success operand is not Int32",
        )
      }
    }
    4 => {
      if instruction.typeId != 4 or instruction.operands.count() != 0 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "failure reference shape does not match the registry",
        )
      }
      if slideR1ProgramHasFailure(program, instruction.immediate) == false {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-010", "failure reference is absent from the decoded table",
        )
      }
    }
    5 => {
      if instruction.typeId != 3 or instruction.operands.count() != 1 or instruction.immediate != 0 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-005", "result failure shape does not match the registry",
        )
      }
      if slideR1ProgramTypeOfValue(
        program, slideR1DecodedIntAt(instruction.operands, 0),
      ) != 4 {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-007", "result failure operand is not FixtureFailure",
        )
      }
    }
    _ => {
      return slideR1ProgramRefusal(
        "SLIDE-R1-PROGRAM-004", "unknown instruction opcode",
      )
    }
  }

  return slideR1ProgramDecision(
    Verdict.Allow, "INSTRUCTION_VALID", "NONE", "", 0,
  )
}

// Validate the complete frozen failure registry from decoded records.
pure flow slideR1ValidateFailures(
  program: SLIDER1DecodedProgram,
) -> SLIDER1ImportDecision
contract { intent { "Validate the complete frozen failure registry from decoded records." } }
{
  if program.failures.count() != 3 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-010", "failure registry must contain exactly three records",
    )
  }
  mut i: Int = 0
  while i < program.failures.count() {
    let failure = slideR1DecodedFailureAt(program.failures, i)
    if failure.failureId != i + 1 or failure.visibilityId != 1 or failure.actionId != 1 {
      return slideR1ProgramRefusal(
        "SLIDE-R1-PROGRAM-010", "failure identity, visibility, or action mismatch",
      )
    }
    match i {
      0 => {
        if failure.classId != 2 or failure.retryId != 1 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-010", "arithmetic failure registry mismatch",
          )
        }
      }
      1 => {
        if failure.classId != 3 or failure.retryId != 2 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-010", "denial failure registry mismatch",
          )
        }
      }
      2 => {
        if failure.classId != 4 or failure.retryId != 2 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-010", "indeterminate failure registry mismatch",
          )
        }
      }
      _ => {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-010", "surplus failure registry entry",
        )
      }
    }
    i = i + 1
  }
  return slideR1ProgramDecision(
    Verdict.Allow, "FAILURES_VALID", "NONE", "", 0,
  )
}

// Validate closed-registry CFG, SSA, types, failures, terminators, and K3 over decoded records only.
pure flow validateSLIDER1DecodedProgram(
  program: SLIDER1DecodedProgram,
) -> SLIDER1ImportDecision
contract {
  intent { "Validate closed-registry CFG, SSA, types, failures, terminators, and K3 over decoded records only." }
}
{
  if program.formatMajor != 1 or program.formatMinor != 0 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "unsupported decoded format version",
    )
  }
  if program.semanticProfileId != "slide.semantic.galerina-gir.v1" or program.digestSuiteId != "slide.digest.sha256.v1" {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "decoded semantic or digest profile mismatch",
    )
  }
  if program.memoryProfileId != "slide.memory.safe-value.v1" or program.fixtureName != "slide_k3_checked_add_v1" {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "decoded memory or fixture profile mismatch",
    )
  }
  if program.stableSymbolId != "slide.fixture.k3-checked-add.v1" or program.qualifierId != 1 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "decoded symbol or qualifier mismatch",
    )
  }
  if program.parameterTypeIds.count() != 3 or slideR1DecodedIntAt(program.parameterTypeIds, 0) != 1 or slideR1DecodedIntAt(program.parameterTypeIds, 1) != 1 or slideR1DecodedIntAt(program.parameterTypeIds, 2) != 2 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "decoded parameter type signature mismatch",
    )
  }
  if program.resultTypeId != 3 or program.entryBlockId != 0 or program.blocks.count() != 4 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-001", "decoded result, entry, or block count mismatch",
    )
  }

  let failureDecision = slideR1ValidateFailures(program)
  if failureDecision.verdict != Verdict.Allow { return failureDecision }

  mut nextResultId: Int = 0
  mut blockIndex: Int = 0
  while blockIndex < program.blocks.count() {
    let block = slideR1DecodedBlockAt(program.blocks, blockIndex)
    if block.blockId != blockIndex {
      return slideR1ProgramRefusal(
        "SLIDE-R1-PROGRAM-002", "block identities are not unique dense indices",
      )
    }
    mut instructionIndex: Int = 0
    while instructionIndex < block.instructions.count() {
      let instruction = slideR1DecodedInstructionAt(
        block.instructions, instructionIndex,
      )
      if instruction.resultId != nextResultId {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-003", "SSA result identities are not unique dense definitions",
        )
      }
      let instructionDecision = slideR1ValidateInstruction(
        program, blockIndex, instruction,
      )
      if instructionDecision.verdict != Verdict.Allow {
        return instructionDecision
      }
      nextResultId = nextResultId + 1
      instructionIndex = instructionIndex + 1
    }

    let terminator = block.terminator
    match terminator.terminatorId {
      1 => {
        if blockIndex != program.entryBlockId or terminator.operands.count() != 4 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-008", "K3 terminator is misplaced or incomplete",
          )
        }
        let subjectId: Int = slideR1DecodedIntAt(terminator.operands, 0)
        if slideR1ProgramOperandVisible(
          program, blockIndex, nextResultId, subjectId,
        ) == false or slideR1ProgramTypeOfValue(program, subjectId) != 2 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-008", "K3 terminator subject is not a visible Verdict",
          )
        }
        let allowBlock: Int = slideR1DecodedIntAt(terminator.operands, 1)
        let denyBlock: Int = slideR1DecodedIntAt(terminator.operands, 2)
        let unresolvedBlock: Int = slideR1DecodedIntAt(terminator.operands, 3)
        let successorsInRange: Bool = allowBlock > 0 and allowBlock < program.blocks.count() and denyBlock > 0 and denyBlock < program.blocks.count() and unresolvedBlock > 0 and unresolvedBlock < program.blocks.count()
        let successorsDistinct: Bool = allowBlock != denyBlock and allowBlock != unresolvedBlock and denyBlock != unresolvedBlock
        if successorsInRange == false or successorsDistinct == false {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-009", "K3 successors are missing, invalid, or aliased",
          )
        }
      }
      2 => {
        if blockIndex == program.entryBlockId or terminator.operands.count() != 1 {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-008", "return terminator is misplaced or incomplete",
          )
        }
        let returnId: Int = slideR1DecodedIntAt(terminator.operands, 0)
        if slideR1ProgramOperandVisible(
          program, blockIndex, nextResultId, returnId,
        ) == false {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-006", "return value is undefined or does not dominate",
          )
        }
        if slideR1ProgramTypeOfValue(program, returnId) != program.resultTypeId {
          return slideR1ProgramRefusal(
            "SLIDE-R1-PROGRAM-007", "return value type does not match the function result",
          )
        }
      }
      _ => {
        return slideR1ProgramRefusal(
          "SLIDE-R1-PROGRAM-008", "unknown or absent block terminator",
        )
      }
    }
    blockIndex = blockIndex + 1
  }

  if nextResultId != 9 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-003", "closed R1 fixture must define exactly nine SSA values",
    )
  }
  if program.k3Obligations.count() != 1 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-011", "closed R1 fixture must declare one K3 obligation",
    )
  }
  let obligation = slideR1DecodedK3At(program.k3Obligations, 0)
  let entry = slideR1DecodedBlockAt(program.blocks, program.entryBlockId)
  if obligation.obligationId != 1 or obligation.functionId != 1 or obligation.checkBlockId != program.entryBlockId {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-011", "K3 obligation identity or check block mismatch",
    )
  }
  if entry.terminator.terminatorId != 1 or entry.terminator.operands.count() != 4 {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-011", "K3 obligation has no matching check terminator",
    )
  }
  if obligation.allowBlockId != slideR1DecodedIntAt(entry.terminator.operands, 1) or obligation.denyBlockId != slideR1DecodedIntAt(entry.terminator.operands, 2) or obligation.indeterminateBlockId != slideR1DecodedIntAt(entry.terminator.operands, 3) {
    return slideR1ProgramRefusal(
      "SLIDE-R1-PROGRAM-011", "K3 obligation successors do not match the terminator",
    )
  }

  return slideR1ProgramDecision(
    Verdict.Allow, "VALIDATED", "NONE",
    "decoded SLIDE R1 program passed CFG, SSA, type, failure, and K3 validation", 0,
  )
}

// Decode and semantically validate R1 bytes; expose a program only after both gates allow.
pure flow importAndValidateSLIDER1Program(bytes: Bytes) -> SLIDER1ProgramImport
contract {
  intent { "Decode and semantically validate R1 bytes; expose a program only after both gates allow." }
}
{
  let decoded = decodeSLIDER1Program(bytes)
  if decoded.decision.verdict != Verdict.Allow {
    return {
      decision: decoded.decision
      program: emptySLIDER1DecodedProgram()
    }
  }
  let validated = validateSLIDER1DecodedProgram(decoded.program)
  if validated.verdict != Verdict.Allow {
    return {
      decision: validated
      program: emptySLIDER1DecodedProgram()
    }
  }
  return { decision: validated program: decoded.program }
}
