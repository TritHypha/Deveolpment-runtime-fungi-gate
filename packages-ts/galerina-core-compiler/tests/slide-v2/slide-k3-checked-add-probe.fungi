@version 1

// G1 capability probe for the proposed SLIDE R1 vertical slice.
//
// This is Galerina source, not a .slide artifact and not proof that executable
// GIR exists. The probe deliberately combines the four source semantics SLIDE
// must preserve: closed K3 dispatch, explicit DENY/INDETERMINATE failures,
// checked Int32 addition, and a typed Result exit.
pure flow slideK3CheckedAddProbe(
  left: Int,
  right: Int,
  admission: Verdict,
) -> Result<Int, String>
contract {
  effects {}
  intent "Probe checked addition only after an exhaustive K3 decision"
}
{
  check(admission) {
    deny: {
      return Err("SLIDE_PROBE_DENIED")
    }
    ambig: {
      return Err("SLIDE_PROBE_INDETERMINATE")
    }
    if: {
      return Ok(left + right)
    }
  }
}
