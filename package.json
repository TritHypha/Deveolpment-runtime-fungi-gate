{
  "name": "@galerina/cli",
  "version": "1.0.0-beta.2",
  "description": "Galerina compiler and runtime CLI — compile .fungi programs to WASM, run them, type-check with governance.",
  "type": "module",
  "bin": {
    "galerina": "./galerina.mjs",
    "fungi": "./galerina.mjs"
  },
  "scripts": {
    "test": "node scripts/run-all-tests.cjs",
    "test:core": "node scripts/run-all-tests.cjs --core",
    "test:list": "node scripts/run-all-tests.cjs --list",
    "phase-close": "node scripts/run-phase-close.mjs --tier phase-close",
    "phase-close:exhaustive": "node scripts/run-phase-close.mjs --tier exhaustive",
    "build:process-warden": "node scripts/build-process-warden.mjs",
    "brand-audit": "node scripts/brand-audit.mjs .",
    "audit:examples": "node scripts/audit-example-diagnostics.mjs",
    "audit:examples:selftest": "node scripts/audit-example-diagnostics.mjs --self-test",
    "audit:node-floor": "node scripts/audit-node-dependencies.mjs",
    "audit:package-topology": "node scripts/audit-flat-package-topology.mjs",
    "audit:package-topology:selftest": "node --test scripts/tests/audit-flat-package-topology.test.mjs",
    "audit:package-root-lock": "node scripts/flat-package-root-lock.mjs --check --json",
    "audit:package-root-lock:selftest": "node --test scripts/tests/flat-package-root-lock.test.mjs scripts/tests/flat-package-root-lock.integration.test.mjs",
    "audit:retirement": "node scripts/ts-retirement-graph.mjs --check",
    "audit:retirement:selftest": "node --test scripts/tests/full-fungi-retirement-gate.test.mjs scripts/tests/post-slide-authority-receipts.test.mjs",
    "audit:retirement:post-slide": "node scripts/ts-retirement-graph.mjs --post-slide",
    "audit:selfhost": "node scripts/audit-selfhost-readiness.mjs --check",
    "audit:imports": "node scripts/audit-import-governance.mjs",
    "audit:license": "node scripts/audit-license-compat.mjs",
    "audit:license:selftest": "node scripts/audit-license-compat.mjs --self-test",
    "audit:percent-history": "node scripts/audit-percent-history.mjs",
    "audit:retention": "node scripts/audit-retention-gate.mjs",
    "audit:retention:selftest": "node scripts/audit-leak-static.mjs --self-test && node scripts/kat-execution-graph-cache-bound.mjs --self-test",
    "audit:retention:nightly": "node scripts/audit-retention-nightly.mjs",
    "audit:governance-algebra": "node tools/verify-governance-algebra.mjs",
    "audit:governance-algebra:selftest": "node tools/verify-governance-algebra.mjs --self-test",
    "audit:fungi-golden": "node scripts/fungi-golden-probe.mjs --check",
    "audit:fungi-golden:update": "node scripts/fungi-golden-probe.mjs --write",
    "audit:registry-static-host-toolchain": "node scripts/verify-registry-static-host-toolchain.mjs",
    "audit:registry-static-host-toolchain:selftest": "node --test scripts/tests/registry-static-host-toolchain.test.mjs",
    "registry:generation": "npm --prefix packages-galerina/galerina-framework-app-kernel run build && node scripts/registry-generation-cli.mjs build-current",
    "registry:generation:check": "npm --prefix packages-galerina/galerina-framework-app-kernel run build && node scripts/registry-generation-cli.mjs check-current"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "galerina",
    "compiler",
    "governance",
    "wasm"
  ],
  "license": "Apache-2.0"
}
